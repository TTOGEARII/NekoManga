<Application x:Class="NekoManga.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── NekoManga 팔레트: 어두운 자주빛 바탕 + 파스텔 핑크/라벤더 ── -->
            <Color x:Key="NekoBgColor">#141019</Color>
            <SolidColorBrush x:Key="NekoBg" Color="#141019"/>
            <SolidColorBrush x:Key="NekoCard" Color="#1E1826"/>
            <SolidColorBrush x:Key="NekoCardHover" Color="#27202F"/>
            <SolidColorBrush x:Key="NekoPink" Color="#FF77A8"/>
            <SolidColorBrush x:Key="NekoPinkSoft" Color="#FFB7D5"/>
            <SolidColorBrush x:Key="NekoLavender" Color="#C5A3FF"/>
            <SolidColorBrush x:Key="NekoText" Color="#F2EDF7"/>
            <SolidColorBrush x:Key="NekoHint" Color="#9A8FA8"/>
            <SolidColorBrush x:Key="NekoStroke" Color="#332A40"/>
            <SolidColorBrush x:Key="NekoCanvas" Color="#1A1A1A"/>

            <!-- 기능 토글 카드 -->
            <Style TargetType="Border" x:Key="NekoFeatureCard">
                <Setter Property="Background" Value="{DynamicResource NekoCard}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NekoStroke}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="16,12"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NekoCardHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource NekoPink}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TextBlock" x:Key="CardTitle">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="HintText">
                <Setter Property="Foreground" Value="{DynamicResource NekoHint}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <!-- 만화 원고 설정표: 섹션 제목을 먹색 라벨 바로 (필름 자막·원고 지시선 느낌) -->
            <Style TargetType="Border" x:Key="MangaSection">
                <Setter Property="BorderBrush" Value="{DynamicResource NekoStroke}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Margin" Value="0,14,0,0"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
            <Style TargetType="Border" x:Key="MangaTag">
                <Setter Property="Background" Value="{DynamicResource NekoStroke}"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,16,0,6"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="MangaTagText">
                <Setter Property="Foreground" Value="{DynamicResource NekoBg}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="SectionTitle">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource NekoPinkSoft}"/>
                <Setter Property="Margin" Value="0,16,0,8"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="FieldLabel">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            </Style>

            <!-- 목록: WPF-UI 다크에서 기본 ListView 글자가 액센트색으로 끌려와 읽기 어렵다.
                 BasedOn 없이 직접 지정 (FanboxUpdater에서 확인된 함정). -->
            <Style TargetType="ListView">
                <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            </Style>
            <Style TargetType="ListViewItem">
                <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#18808080"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#20808080"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource NekoPinkSoft}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NekoStroke}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="6,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <!-- 설정 탭 (WPF-UI 다크에서 BasedOn 쓰면 밝은 테마가 끌려오므로 직접 템플릿).
                 탭 줄(헤더)과 내용 영역을 시각적으로 분리 — 내용은 먹선 두른 원고 패널 안에. -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- 탭 줄: 살짝 들여 쓰고, 선택 탭만 내용 패널 테두리를 덮어 이어진다 -->
                                <TabPanel Grid.Row="0" IsItemsHost="True" Margin="10,0,10,0" Panel.ZIndex="1"/>
                                <!-- 내용 패널: 탭과 붙어 보이게 위 테두리까지 먹선, 안쪽은 종이 -->
                                <Border Grid.Row="1" Background="{DynamicResource NekoCard}"
                                        BorderBrush="{DynamicResource NekoStroke}" BorderThickness="2"
                                        CornerRadius="0">
                                    <ContentPresenter ContentSource="SelectedContent" Margin="6"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 서류철 탭: 아래 테두리 없이 내용 패널 윗선이 탭 바닥을 닫아 준다.
                 선택 탭은 내용과 같은 종이색 + 패널 윗선을 2px 덮어 '열려 이어진 탭'이 된다
                 (먹색 꽉 채움은 어색하다는 피드백으로 교체). 미선택 탭은 5px 낮고 살짝 바랜다. -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="{DynamicResource NekoBg}"
                                    BorderBrush="{DynamicResource NekoStroke}" BorderThickness="2,2,2,0"
                                    CornerRadius="0" Padding="14,6" Margin="0,5,4,0">
                                <ContentPresenter x:Name="Hd" ContentSource="Header" Opacity="0.55"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NekoCardHover}"/>
                                    <Setter TargetName="Hd" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NekoCard}"/>
                                    <Setter TargetName="Bd" Property="Margin" Value="0,0,4,-2"/>
                                    <Setter TargetName="Bd" Property="Padding" Value="14,8,14,9"/>
                                    <Setter TargetName="Hd" Property="Opacity" Value="1"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
