<Application x:Class="NekoManga.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── NekoManga 팔레트: 어두운 자주빛 바탕 + 파스텔 핑크/라벤더 ── -->
            <Color x:Key="NekoBgColor">#141019</Color>
            <SolidColorBrush x:Key="NekoBg" Color="#141019"/>
            <SolidColorBrush x:Key="NekoCard" Color="#1E1826"/>
            <SolidColorBrush x:Key="NekoCardHover" Color="#27202F"/>
            <SolidColorBrush x:Key="NekoPink" Color="#FF77A8"/>
            <SolidColorBrush x:Key="NekoPinkSoft" Color="#FFB7D5"/>
            <SolidColorBrush x:Key="NekoLavender" Color="#C5A3FF"/>
            <SolidColorBrush x:Key="NekoText" Color="#F2EDF7"/>
            <SolidColorBrush x:Key="NekoHint" Color="#9A8FA8"/>
            <SolidColorBrush x:Key="NekoStroke" Color="#332A40"/>

            <!-- 기능 토글 카드 -->
            <Style TargetType="Border" x:Key="NekoFeatureCard">
                <Setter Property="Background" Value="{StaticResource NekoCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NekoStroke}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="16,12"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource NekoCardHover}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource NekoPink}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TextBlock" x:Key="CardTitle">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource NekoText}"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="HintText">
                <Setter Property="Foreground" Value="{StaticResource NekoHint}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="SectionTitle">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{StaticResource NekoPinkSoft}"/>
                <Setter Property="Margin" Value="0,16,0,8"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="FieldLabel">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="Foreground" Value="{StaticResource NekoText}"/>
            </Style>

            <!-- 목록: WPF-UI 다크에서 기본 ListView 글자가 액센트색으로 끌려와 읽기 어렵다.
                 BasedOn 없이 직접 지정 (FanboxUpdater에서 확인된 함정). -->
            <Style TargetType="ListView">
                <Setter Property="Foreground" Value="{StaticResource NekoText}"/>
            </Style>
            <Style TargetType="ListViewItem">
                <Setter Property="Foreground" Value="{StaticResource NekoText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#14FF77A8"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#22FF77A8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Foreground" Value="{StaticResource NekoPinkSoft}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource NekoStroke}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="6,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <!-- 설정 탭 (WPF-UI 다크에서 BasedOn 쓰면 밝은 테마가 끌려오므로 직접 템플릿) -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0,8,0,0"/>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource NekoHint}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="2,0" Padding="18,8">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FF77A8"/>
                                    <Setter Property="Foreground" Value="{StaticResource NekoPinkSoft}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FF77A8"/>
                                    <Setter Property="Foreground" Value="{StaticResource NekoPinkSoft}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
