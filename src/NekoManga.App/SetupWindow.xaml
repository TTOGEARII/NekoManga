<ui:FluentWindow x:Class="NekoManga.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NekoManga 첫 준비" Height="660" Width="730"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        ResizeMode="NoResize"
        Background="{StaticResource NekoBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="처음 준비 중이에요" ShowMinimize="False" ShowMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="24,8,24,4">
            <TextBlock Text="(=^･ω･^=) AI 엔진을 준비할게요" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource NekoPinkSoft}"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                       Text="채색·번역에 필요한 구성요소를 자동으로 내려받아요. 모델이 커서(전체 약 20GB) 처음 한 번은 시간이 걸려요 — 중간에 꺼도 이어받아요."/>
            <DockPanel Margin="0,12,0,0">
                <TextBlock Text="설치 드라이브" Style="{StaticResource FieldLabel}"/>
                <ui:Button DockPanel.Dock="Right" Content="폴더 직접 선택" Click="BtnPickRoot_Click" Padding="12,4" Margin="8,0,0,0"/>
                <ComboBox x:Name="CmbDrive" SelectionChanged="CmbDrive_Changed"/>
            </DockPanel>
            <TextBlock x:Name="TxtRoot" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
            <TextBlock x:Name="TxtSpace" Margin="0,4,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource NekoText}"/>
            <!-- ComfyUI 묶음 전제 조건 (드라이버·VC++·VRAM·RAM) — 미충족이면 받을 곳을 바로 안내한다 -->
            <Border x:Name="PnlReq" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8" BorderThickness="2"
                    BorderBrush="{StaticResource NekoStroke}" Background="{StaticResource NekoCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="그래픽카드" Style="{StaticResource FieldLabel}" Width="80"/>
                        <ComboBox x:Name="CmbGpu" Width="300" HorizontalAlignment="Left" SelectionChanged="CmbGpu_Changed"
                                  ToolTip="채색 엔진(ComfyUI) 묶음을 그래픽카드에 맞는 빌드로 받아요. 보통은 자동 감지면 돼요.">
                            <ComboBoxItem Tag="auto" Content="자동 감지"/>
                            <ComboBoxItem Tag="nvidia" Content="NVIDIA RTX 20 이상"/>
                            <ComboBoxItem Tag="nvidia-old" Content="NVIDIA GTX 10 이하 (구형)"/>
                            <ComboBoxItem Tag="amd" Content="AMD Radeon RX 6000 이상"/>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock x:Name="TxtReqTitle" FontWeight="SemiBold" Foreground="{StaticResource NekoText}" Text="PC 점검" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtReq" Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,0">
                        <ui:Button x:Name="BtnReqDriver" Content="⬇ NVIDIA 드라이버 받기" Click="BtnReqDriver_Click" Padding="10,4" Visibility="Collapsed"/>
                        <ui:Button x:Name="BtnReqVc" Content="⬇ VC++ 런타임 받기" Click="BtnReqVc_Click" Padding="10,4" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <ui:Button x:Name="BtnReqRecheck" Content="↻ 다시 확인" Click="BtnReqRecheck_Click" Padding="10,4" Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ListView x:Name="CompList" Grid.Row="2" Margin="24,8" Background="Transparent" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="구성요소" Width="390" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="상태" Width="140" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="진행" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100"
                                             Height="8" Width="95" Foreground="{StaticResource NekoPink}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{StaticResource NekoStroke}">
            <DockPanel>
                <TextBlock x:Name="TxtNote" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Style="{StaticResource HintText}" MaxWidth="330"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnSkip" Content="나중에" Click="BtnSkip_Click" Padding="16,8"/>
                    <ui:Button x:Name="BtnInstall" Content="✦ 준비 시작!" Click="BtnInstall_Click"
                               Appearance="Primary" FontWeight="Bold" Padding="20,8" Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
