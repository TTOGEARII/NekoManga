<ui:FluentWindow x:Class="NekoManga.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NekoManga 첫 준비" Height="560" Width="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        ResizeMode="NoResize"
        Background="{StaticResource NekoBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="처음 준비 중이에요" ShowMinimize="False" ShowMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="24,8,24,4">
            <TextBlock Text="(=^･ω･^=) AI 엔진을 준비할게요" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource NekoPinkSoft}"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                       Text="채색·번역에 필요한 구성요소를 자동으로 내려받아요. 모델이 커서(전체 약 20GB) 처음 한 번은 시간이 걸려요 — 중간에 꺼도 이어받아요."/>
            <DockPanel Margin="0,12,0,0">
                <TextBlock Text="설치 드라이브" Style="{StaticResource FieldLabel}"/>
                <ui:Button DockPanel.Dock="Right" Content="폴더 직접 선택" Click="BtnPickRoot_Click" Padding="12,4" Margin="8,0,0,0"/>
                <ComboBox x:Name="CmbDrive" SelectionChanged="CmbDrive_Changed"/>
            </DockPanel>
            <TextBlock x:Name="TxtRoot" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
            <TextBlock x:Name="TxtSpace" Margin="0,4,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource NekoText}"/>
        </StackPanel>

        <ListView x:Name="CompList" Grid.Row="2" Margin="24,8" Background="Transparent" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="구성요소" Width="300" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="상태" Width="140" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="진행" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100"
                                             Height="8" Width="95" Foreground="{StaticResource NekoPink}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{StaticResource NekoStroke}">
            <DockPanel>
                <TextBlock x:Name="TxtNote" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Style="{StaticResource HintText}" MaxWidth="330"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnSkip" Content="나중에" Click="BtnSkip_Click" Padding="16,8"/>
                    <ui:Button x:Name="BtnInstall" Content="✦ 준비 시작!" Click="BtnInstall_Click"
                               Appearance="Primary" FontWeight="Bold" Padding="20,8" Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
