<ui:FluentWindow x:Class="NekoManga.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NekoManga 첫 준비" Height="740" Width="730"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        ResizeMode="NoResize"
        Background="{DynamicResource NekoBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 창 전체에 깔리는 은은한 톤망점 (원고 질감) — 메인·설정 창과 동일 -->
        <Rectangle Fill="{DynamicResource MangaDots}" Grid.RowSpan="4" IsHitTestVisible="False"/>

        <ui:TitleBar Grid.Row="0" Title="처음 준비 중이에요" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{DynamicResource NekoLogo}"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <!-- 머리: 선화 고양이 + 제목 (드롭존과 같은 구성) -->
            <DockPanel>
                <Image Source="{DynamicResource NekoLogo}" Width="52" Height="52" DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AI 엔진을 준비할게요" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource NekoText}"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="채색·번역에 필요한 구성요소를 자동으로 내려받아요. 모델이 커서(전체 약 20GB) 처음 한 번은 시간이 걸려요 — 중간에 꺼도 이어받아요."/>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource MangaTag}" Margin="0,12,0,4"><TextBlock Style="{StaticResource MangaTagText}" Text="설치 위치"/></Border>
            <DockPanel>
                <TextBlock Text="설치 드라이브" Style="{StaticResource FieldLabel}"/>
                <ui:Button DockPanel.Dock="Right" Content="폴더 직접 선택" Click="BtnPickRoot_Click" Padding="12,4" Margin="8,0,0,0"/>
                <ComboBox x:Name="CmbDrive" SelectionChanged="CmbDrive_Changed"/>
            </DockPanel>
            <TextBlock x:Name="TxtRoot" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtSpace" Margin="0,2,0,0" FontWeight="SemiBold" Foreground="{DynamicResource NekoText}"/>

            <!-- ComfyUI 묶음 전제 조건 (그래픽카드·드라이버·VC++·VRAM·RAM) — 미충족이면 받을 곳을 바로 안내한다 -->
            <Border x:Name="PnlReq" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8" BorderThickness="2"
                    BorderBrush="{DynamicResource NekoStroke}" Background="{DynamicResource NekoCard}">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource MangaTag}" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource MangaTagText}" Text="PC 점검"/></Border>
                        <TextBlock Text="그래픽카드" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbGpu" Width="250" HorizontalAlignment="Left" SelectionChanged="CmbGpu_Changed"
                                  ToolTip="채색 엔진(ComfyUI) 묶음을 그래픽카드에 맞는 빌드로 받아요. 보통은 자동 감지면 돼요.">
                            <ComboBoxItem Tag="auto" Content="자동 감지"/>
                            <ComboBoxItem Tag="nvidia" Content="NVIDIA RTX 20 이상"/>
                            <ComboBoxItem Tag="nvidia-old" Content="NVIDIA GTX 10 이하 (구형)"/>
                            <ComboBoxItem Tag="amd" Content="AMD Radeon RX 6000 이상"/>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock x:Name="TxtReqTitle" FontWeight="SemiBold" Foreground="{DynamicResource NekoText}" Text="PC 점검" Margin="0,8,0,0"/>
                    <TextBlock x:Name="TxtReq" Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,0">
                        <ui:Button x:Name="BtnReqDriver" Content="⬇ NVIDIA 드라이버 받기" Click="BtnReqDriver_Click" Padding="10,4" Visibility="Collapsed"/>
                        <ui:Button x:Name="BtnReqVc" Content="⬇ VC++ 런타임 받기" Click="BtnReqVc_Click" Padding="10,4" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <ui:Button x:Name="BtnReqRecheck" Content="↻ 다시 확인" Click="BtnReqRecheck_Click" Padding="10,4" Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- PC 사양 맞춤 설정 (VRAM·RAM 등급별 해상도·엔진 인자·미리 켜기) — [준비 시작!] 때 적용 -->
            <Border x:Name="PnlTune" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8" BorderThickness="2"
                    BorderBrush="{DynamicResource NekoStroke}" Background="{DynamicResource NekoCard}">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource MangaTag}" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource MangaTagText}" Text="이 PC 맞춤"/></Border>
                        <CheckBox x:Name="ChkTune" IsChecked="True" Foreground="{DynamicResource NekoText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                  Content="이 PC 사양에 맞춰 설정을 자동으로 조정하기 (권장)"
                                  ToolTip="준비 시작을 누를 때 아래 항목을 바꿔요. 나중에 설정 → 엔진 탭의 [이 PC에 맞게 조정]으로 다시 할 수 있어요."/>
                    </DockPanel>
                    <TextBlock x:Name="TxtTuneHw" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtTune" Style="{StaticResource HintText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MangaTag}" Margin="0,12,0,0"><TextBlock Style="{StaticResource MangaTagText}" Text="구성요소"/></Border>
        </StackPanel>

        <!-- 구성요소 목록: 메인 창 목록과 같은 먹선 패널 안에 -->
        <Border Grid.Row="2" Margin="24,0,24,8" Background="{DynamicResource NekoCard}"
                BorderBrush="{DynamicResource NekoStroke}" BorderThickness="2">
            <ListView x:Name="CompList" Background="Transparent" BorderThickness="0" Margin="4,2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="구성요소" Width="390" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="상태" Width="140" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="진행" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100"
                                                 Height="8" Width="95" Foreground="{DynamicResource NekoPink}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="3" Padding="24,12" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource NekoStroke}">
            <DockPanel>
                <TextBlock x:Name="TxtNote" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Style="{StaticResource HintText}" MaxWidth="330"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnSkip" Content="나중에" Click="BtnSkip_Click" Padding="16,8"/>
                    <ui:Button x:Name="BtnInstall" Content="✦ 준비 시작!" Click="BtnInstall_Click"
                               Appearance="Primary" FontWeight="Bold" Padding="20,8" Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
