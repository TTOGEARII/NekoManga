                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="CN 끝 (0 ~ 1)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtRegenCnEnd" Width="70" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="축소 MP (0 ~ 8, 0=원본)" Style="{StaticResource FieldLabel}" Width="150"/>
