                                                <TextBlock Text="최소 재료 쪽수" Style="{StaticResource SetLabel}"/>
                                                <TextBox DockPanel.Dock="Left" x:Name="TxtSelfMinPages" Width="70" HorizontalAlignment="Left"/>
                                                <TextBlock Text="5 ~ 500" Style="{StaticResource SetRange}"/>
                                            </DockPanel>
                                        </UniformGrid>
                                        <TextBlock Style="{StaticResource SetHint}" Text="기본값(5에폭·0.0002·백본 동결)은 기존 실력을 잊지 않게 보수적으로 잡은 값이다냥."/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 고급: 워크플로를 아는 사용자용 — 접힌 상태가 기본 -->
                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <ToggleButton x:Name="BtnDecensorAdv" Style="{StaticResource SetCardToggle}" Content="고급 옵션 — 워크플로 직접 제어"/>
                                <StackPanel x:Name="PnlDecensorAdv" Style="{StaticResource SideBody}"
                                            Visibility="{Binding IsChecked, ElementName=BtnDecensorAdv, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource HintText}" Text="ComfyUI 워크플로에 들어가는 값 그대로다냥.&#10;· 바꾼 값은 다음 작업부터다냥."/>

                                    <TextBlock Text="재생성 워크플로 (SDXL)" Style="{StaticResource SetSub}"/>
                                    <DockPanel Style="{StaticResource SetRow}">
                                        <TextBlock Text="체크포인트 파일" Style="{StaticResource SetLabel}"/>
