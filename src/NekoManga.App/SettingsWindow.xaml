                                    <TextBlock Text="질내사정 태그 — 질내사정인 조각에만 넣는다냥" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
                                    <TextBox x:Name="TxtRegenBodyCum" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="28"/>
                                    <CheckBox x:Name="ChkRegenCumAuto" Content="질내사정인지 자동으로 판단한다냥 (조각마다 직접 고칠 수 있다냥)" Foreground="{DynamicResource NekoText}" Margin="0,6,0,0"
                                              ToolTip="질내사정인 자리에만 위 태그를 더한다냥. 자동 판단은 틀릴 수 있으니 결과 창의 '사정' 표시로 고쳐 줘냥. 태그 칸을 비우면 안 넣는다냥."/>
                                    <!-- 2026-11-15 사용자 "남자거에 계속 여자거가 그려지는데 … 남/여 구분을 확실하게": 기본 켬 — 조각마다 성별을 가려(RegenRegion.PieceSex + 결과 창에서 직접 고른 것) 한쪽뿐인 영역에는 그쪽 태그만. 끄면 늘 같이(2026-11-13의 기본) -->
                                    <CheckBox x:Name="ChkRegenTagsBySex" Content="확실한 부위에는 그쪽 태그만 넣는다냥 (아니면 같이)" Foreground="{DynamicResource NekoText}" Margin="0,6,0,0"
