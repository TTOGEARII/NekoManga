<ui:FluentWindow x:Class="NekoManga.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="설정" Height="740" Width="1040" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{DynamicResource NekoBg}">
    <!-- 설정 창의 짜임(2026-11-26 사용자 "설정이 많아지며 가독성이 떨어진다 — 칸을 잘 나눠 달라" → 왼쪽 목록형 + 카드 + 설명은 한 줄과 툴팁):
         왼쪽 세로 목록(SideNavTabs — 탭은 SettingsTabs 그대로라 코드·하네스의 SelectedIndex가 안 바뀐다) + 오른쪽 내용. 묶음은 결과 창과 같은 카드(App.xaml의 SideCard 계열).
         칸 줄은 SetRow(이름 150px | 입력 | 범위) — 범위 "(0.3 ~ 4)"는 칸 이름에서 떼어 옅은 글로 둔다(이름이 두 줄로 꺾이던 것). 설명은 카드마다 한 줄, 칸별 자세한 설명은 그 칸의 ToolTip.
         접히는 묶음(고급 옵션·규칙 감지기 세부)은 제목 띠가 ToggleButton(SideCardToggle)이고 본문 Visibility를 IsChecked에 바인딩한다 — 코드 없이 접힌다. x:Name과 이벤트는 전과 같다(코드 비하인드는 이름으로 찾는다). -->
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 왼쪽 목록형 탭: 영어·일본어에서 위쪽 탭이 두 줄로 꺾이던 것도 사라진다. 고른 항목은 카드 제목 띠와 같은 먹색 띠 -->
        <Style x:Key="SideNavTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TabPanel Grid.Column="0" IsItemsHost="True" Margin="0,6,12,0"/>
                            <Border Grid.Column="1" Background="{DynamicResource NekoCard}"
                                    BorderBrush="{DynamicResource NekoStroke}" BorderThickness="2" CornerRadius="0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SideNavTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,9" Margin="0,0,0,4" Cursor="Hand">
                            <ContentPresenter x:Name="Hd" ContentSource="Header" VerticalAlignment="Center" Opacity="0.75"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NekoCardHover}"/>
                                <Setter TargetName="Hd" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NekoStroke}"/>
                                <Setter TargetName="Hd" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource NekoBg}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 칸 줄: 이름(폭 150, 넘치면 줄 바꿈) | 입력 | 범위(옅은 글) -->
        <Style x:Key="SetRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,3,12,3"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="SetLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Width" Value="150"/>
        </Style>
        <Style x:Key="SetRange" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NekoHint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <!-- 카드의 설명 한 줄(본문 끝) -->
        <Style x:Key="SetHint" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <!-- 접히는 카드의 제목 띠 — 결과 창의 것(Focusable=False: 거기선 Space가 손 도구)과 달리 키보드로도 펼 수 있게(검수 2026-11-26) -->
        <Style x:Key="SetCardToggle" TargetType="ToggleButton" BasedOn="{StaticResource SideCardToggle}">
            <Setter Property="Focusable" Value="True"/>
        </Style>
        <!-- 카드 본문 안의 작은 묶음 제목 -->
        <Style x:Key="SetSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 원고 질감 배경 -->
        <Rectangle Fill="{DynamicResource MangaDots}" Grid.RowSpan="2" IsHitTestVisible="False"/>

        <ui:TitleBar Grid.Row="0" Title="설정 ⚙ (창을 닫으면 저장된다냥)" ShowMinimize="False" ShowMaximize="False"/>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="16,4,16,16" Style="{StaticResource SideNavTabs}">

            <!-- ── 채색 ── -->
            <TabItem Header="🎨 채색" Style="{StaticResource SideNavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,4">
                    <StackPanel>
                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="품질 · 속도"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <UniformGrid Columns="2" Rows="4">
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="해상도 상한 MP" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtMegapixels" Width="80" HorizontalAlignment="Left" ToolTip="8GB VRAM이면 1.5MP를 넘기지 말라냥."/>
                                            <TextBlock Text="0.3 ~ 4" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="스텝 수" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtSteps" Width="80" HorizontalAlignment="Left"/>
                                            <TextBlock Text="5 ~ 100" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="CFG" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtCfg" Width="80" HorizontalAlignment="Left"/>
                                            <TextBlock Text="1 ~ 15" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="Denoise" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtDenoise" Width="80" HorizontalAlignment="Left"/>
                                            <TextBlock Text="0.1 ~ 1" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="샘플러" Style="{StaticResource SetLabel}"/>
                                            <ComboBox x:Name="CmbSampler" MinWidth="170" HorizontalAlignment="Left">
                                                <ComboBoxItem Content="dpmpp_sde_gpu"/>
                                                <ComboBoxItem Content="dpmpp_2m"/>
                                                <ComboBoxItem Content="euler_ancestral"/>
                                            </ComboBox>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="선화 합성 %" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtLineart" Width="80" HorizontalAlignment="Left"/>
                                            <TextBlock Text="0 ~ 100" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="시드" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtSeed" Width="100" HorizontalAlignment="Left"/>
                                            <TextBlock Text="-1 = 랜덤" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <Border/>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource SetHint}" Text="dpmpp_sde_gpu는 품질(장당 ~90초), dpmpp_2m은 속도(~55초)다냥."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="컬러 표지로 캐릭터 색 맞추기"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <DockPanel Margin="0,2,0,0">
                                        <!-- 미리보기 겸 드롭존 — 표지를 여기에 끌어다 놓으면 등록된다 -->
                                        <Border x:Name="RefDropZone" DockPanel.Dock="Left" Width="96" Height="128"
                                                Background="{DynamicResource NekoCanvas}" CornerRadius="0" Margin="0,0,12,0"
                                                BorderBrush="{DynamicResource NekoStroke}" BorderThickness="1"
                                                AllowDrop="True" Drop="RefDropZone_Drop" DragOver="RefDropZone_DragOver">
                                            <Grid>
                                                <TextBlock x:Name="TxtRefDropHint" Text="표지를&#10;끌어다&#10;놓으라냥"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextAlignment="Center" Foreground="{DynamicResource NekoHint}"/>
                                                <Image x:Name="ImgRefPreview" Stretch="Uniform" Margin="3"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel>
                                            <DockPanel>
                                                <ui:Button x:Name="BtnRefExtract" DockPanel.Dock="Right" Content="🎨 색 뽑기"
                                                           Click="BtnRefExtract_Click" Padding="12,4" Margin="8,0,0,0"/>
                                                <ui:Button DockPanel.Dock="Right" Content="찾기" Click="BtnRefBrowse_Click" Padding="12,4" Margin="8,0,0,0"/>
                                                <TextBox x:Name="TxtColorRefImage" TextChanged="TxtColorRefImage_Changed"/>
                                            </DockPanel>
                                            <TextBox x:Name="TxtColorRefTags" AcceptsReturn="True" MinLines="2" MaxLines="6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <DockPanel Style="{StaticResource SetRow}" Margin="0,6,0,0">
                                                <TextBlock Text="표지 반영 강도" Style="{StaticResource SetLabel}"/>
                                                <TextBox DockPanel.Dock="Left" x:Name="TxtRefStrength" Width="64" HorizontalAlignment="Left" ToolTip="반영 강도는 0.4~0.6을 권한다냥."/>
                                                <TextBlock Text="0 ~ 1.5" Style="{StaticResource SetRange}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SetHint}" Text="표지를 등록하면 ① [색 뽑기]로 머리·눈·의상 색 태그를 뽑고, ② IPAdapter가 있으면 표지의 색·화풍을 직접 주입한다냥."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="태그 · 프롬프트"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <TextBlock Text="캐릭터 태그 (수동)" Style="{StaticResource SetSub}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtManualTags" AcceptsReturn="True" MinLines="2" MaxLines="6" TextWrapping="Wrap"
                                             ToolTip="예: blonde hair, amber eyes — 머리·눈 색을 적으면 채색이 일관된다냥."/>
                                    <TextBlock Text="자동 태그에서 뺄 태그" Style="{StaticResource SetSub}"/>
                                    <TextBox x:Name="TxtExcludeTags"/>
                                    <TextBlock Text="부정 프롬프트" Style="{StaticResource SetSub}"/>
                                    <TextBox x:Name="TxtNegative" AcceptsReturn="True" MinLines="2" MaxLines="6" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource SetHint}" Text="예: blonde hair, amber eyes — 머리·눈 색을 적으면 채색이 일관된다냥."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 검열 제거 ── -->
            <TabItem Header="🙈 검열 제거" Style="{StaticResource SideNavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,4">
                    <StackPanel>
                        <!-- 지금 설정 요약 (2026-11-09): 감지·복원 엔진이 따로 골라져 헷갈린다는 피드백 — 고른 값이 실제로 무엇을 돌리는지 두 줄로 풀어 보여 준다 -->
                        <Border x:Name="CardFlow" Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="지금 설정으로는 이렇게 돈다냥"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock Text="① 찾기" FontWeight="SemiBold" Foreground="{DynamicResource NekoText}" Width="76" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="TxtFlowFind" Foreground="{DynamicResource NekoText}" TextWrapping="Wrap" Text=""/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,4">
                                        <TextBlock Text="② 지우기" FontWeight="SemiBold" Foreground="{DynamicResource NekoText}" Width="76" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="TxtFlowFix" Foreground="{DynamicResource NekoText}" TextWrapping="Wrap" Text=""/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── ① 검열 찾기 ── -->
                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="① 검열 찾기"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <!-- 감지 엔진은 Aletheia Lens 하나 — '이전 방식'(전용 AI·규칙 감지기) 엔진 선택은 2026-11-12 사용자 선택으로 삭제 -->
                                    <DockPanel Style="{StaticResource SetRow}">
                                        <TextBlock Text="무엇을 찾을까냥" Style="{StaticResource SetLabel}"/>
                                        <ComboBox x:Name="CmbDecensorTarget"
                                                  SelectionChanged="CmbDecensorTarget_Changed">
                                            <ComboBoxItem Tag="Auto" Content="자동 — 전부 찾기 (권장)"/>
                                            <ComboBoxItem Tag="BlackBar" Content="검은색 막대(먹줄)만"/>
                                            <ComboBoxItem Tag="WhiteBar" Content="흰색 막대만"/>
                                            <ComboBoxItem Tag="Mosaic" Content="모자이크만"/>
                                            <ComboBoxItem Tag="Color" Content="색 검열만 (파란·빨간 막대·틴트 모자이크)"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <!-- Aletheia + 자동일 때만: 놓치는 종류를 전용 AI(CensorNet)가 보완 -->
                                    <StackPanel x:Name="PnlAssist">
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="놓친 검열 보완" Style="{StaticResource SetLabel}"/>
                                            <ComboBox x:Name="CmbLegacyAssist" SelectionChanged="DecensorUi_Changed"
                                                      ToolTip="Aletheia Lens는 검은 막대는 잘 찾지만 가는 흰 막대선·모자이크를 놓치기도 한다냥.&#10;· 모자이크가 자주 남으면 '흰 막대선 + 모자이크'로 바꿔 보라냥.">
                                                <ComboBoxItem Tag="White" Content="가는 흰 막대선만 전용 AI로 보완 (권장)"/>
                                                <ComboBoxItem Tag="WhiteMosaic" Content="흰 막대선 + 모자이크를 전용 AI로 보완"/>
                                                <ComboBoxItem Tag="All" Content="전용 AI가 찾은 것 전부 합치기 (흰·검·모자이크)"/>
                                                <ComboBoxItem Tag="None" Content="보완 안 함 — Aletheia Lens만"/>
                                            </ComboBox>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- 감지 모델 상태 — 설치 여부와 지금 맡은 일을 보여 준다 -->
                                    <Border x:Name="CardCensorAi" Background="{DynamicResource NekoCanvas}"
                                            BorderBrush="{DynamicResource NekoStroke}" BorderThickness="1" CornerRadius="0"
                                            Padding="10,8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <Ellipse x:Name="DotCensorAi" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCensorAi" Margin="10,0,0,0" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Text="검열 감지 AI 상태 확인 중이다냥..."/>
                                            </DockPanel>
                                            <DockPanel x:Name="RowAssistAi" Margin="0,6,0,0">
                                                <Ellipse x:Name="DotAssistAi" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtAssistAi" Margin="10,0,0,0" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" TextWrapping="Wrap" Text=""/>
                                            </DockPanel>
                                            <TextBlock x:Name="TxtCensorAiHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" Text=""/>
                                            <ui:Button x:Name="BtnInstallCensorAi" Content="⬇ 검열 감지·복원 모델 설치"
                                                       Click="BtnOpenSetup_Click" Padding="14,6" Margin="0,8,0,0"
                                                       HorizontalAlignment="Left" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 마스크 확장: LaMa·GPU 방식처럼 넓은 마스크가 필요한 복원에만 쓴다 (Aletheia 복원은 원본처럼 1px) -->
                                    <DockPanel Style="{StaticResource SetRow}" Margin="0,10,0,0">
                                        <TextBlock Text="마스크 확장 px" Style="{StaticResource SetLabel}"/>
                                        <TextBox DockPanel.Dock="Left" x:Name="TxtMaskGrow" Width="80" HorizontalAlignment="Left"
                                                 ToolTip="찾은 영역 둘레를 이만큼 더 지운다냥.&#10;· 재생성·커스텀과 LaMa 복원에 쓴다냥 — Aletheia 복원은 1px만 넓힌다냥."/>
                                        <TextBlock Text="0 ~ 64" Style="{StaticResource SetRange}"/>
                                    </DockPanel>
                                    <CheckBox x:Name="ChkBubbleFilter" Content="흰 말풍선 필터 (전용 AI의 흰 검출 중 글자 블록과 겹치는 것 버리기)" Foreground="{DynamicResource NekoText}" Margin="0,6,0,0"
                                              ToolTip="기본 꺼짐이다냥.&#10;· 켜면 말풍선 오탐은 줄지만 진짜 흰선도 일부 놓친다냥."/>

                                    <!-- 규칙 감지기 전용 세부값 — 전용 AI 없는 흰 막대·색 검열 규칙 감지에만 쓰이므로 접어 둔다 -->
                                    <Border Style="{StaticResource SideCard}" Margin="0,12,0,4">
                                        <StackPanel>
                                            <ToggleButton x:Name="BtnManualDetect" Style="{StaticResource SetCardToggle}" Content="규칙 감지기 세부 설정 (흰 막대·색 검열 규칙용)"/>
                                            <StackPanel x:Name="PnlManualDetect" Style="{StaticResource SideBody}"
                                                        Visibility="{Binding IsChecked, ElementName=BtnManualDetect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource HintText}" Text="규칙 감지기에만 쓰는 값이다냥 — AI 감지에는 영향이 없다냥."/>
                                                <UniformGrid Columns="2" Rows="1" Margin="0,4,0,0">
                                                    <DockPanel Style="{StaticResource SetRow}">
                                                        <TextBlock Text="막대 최소 비율" Style="{StaticResource SetLabel}"/>
                                                        <TextBox DockPanel.Dock="Left" x:Name="TxtBarAspect" Width="70" HorizontalAlignment="Left"
                                                                 ToolTip="비율은 가로세로 비(1.8 = 긴 쪽이 1.8배 이상)다냥.&#10;· 네모난 검열도 잡으려면 1.2까지 낮춰 보라냥.&#10;· 크기는 px²다냥."/>
                                                        <TextBlock Text="1 ~ 10" Style="{StaticResource SetRange}"/>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource SetRow}">
                                                        <TextBlock Text="막대 최소 크기" Style="{StaticResource SetLabel}"/>
                                                        <TextBox DockPanel.Dock="Left" x:Name="TxtBarMinArea" Width="70" HorizontalAlignment="Left"
                                                                 ToolTip="비율은 가로세로 비(1.8 = 긴 쪽이 1.8배 이상)다냥.&#10;· 네모난 검열도 잡으려면 1.2까지 낮춰 보라냥.&#10;· 크기는 px²다냥."/>
                                                        <TextBlock Text="50 ~ 500000" Style="{StaticResource SetRange}"/>
                                                    </DockPanel>
                                                </UniformGrid>
                                                <TextBlock Text="모자이크 규칙 감지 세부 (지금은 Aletheia Lens가 찾아서 안 쓴다냥)" Style="{StaticResource SetSub}"/>
