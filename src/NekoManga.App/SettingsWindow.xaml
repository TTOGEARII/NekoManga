                                            <TextBlock Text="256 ~ 4096" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="XDoG 임계값" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtAdvXdog" Width="70" HorizontalAlignment="Left"
                                                     ToolTip="전처리 해상도(기본 1280)는 선화 추출 크기다냥 — 높이면 가는 선을 더 잡지만 느리다냥.&#10;· XDoG 임계값(기본 32)은 스케치 선의 진하기다냥."/>
                                            <TextBlock Text="1 ~ 128" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="원본 레시피: 선화가 0~60%, 스케치가 60~100% 구간을 맡는다냥."/>

                                    <TextBlock Text="표지 주입 (IPAdapter)" Style="{StaticResource SetSub}"/>
                                    <UniformGrid Columns="2" Rows="1">
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="적용 끝 지점" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtAdvIpaEnd" Width="70" HorizontalAlignment="Left" ToolTip="0~1 (기본 0.9)다냥.&#10;· 낮추면 마무리에서 표지 영향이 빠진다냥."/>
                                            <TextBlock Text="0 ~ 1" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <Border/>
                                    </UniformGrid>

                                    <ui:Button Content="기본값 복원" Click="BtnEngineAdvReset_Click" Margin="0,10,0,4" Padding="12,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 구성요소 ── -->
            <TabItem Header="📦 구성요소" Style="{StaticResource SideNavTab}">
