                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="포트" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtAdvPort" Width="80" HorizontalAlignment="Left"/>
                                            <TextBlock Text="1024 ~ 65535" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <Border/>
                                    </UniformGrid>
                                    <DockPanel Style="{StaticResource SetRow}">
                                        <TextBlock Text="추가 실행 인자" Style="{StaticResource SetLabel}"/>
