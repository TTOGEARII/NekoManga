                                                   Foreground="{DynamicResource NekoText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button x:Name="BtnEngineStart" Content="▶ 켜기" Click="BtnEngineStart_Click" Padding="14,4"/>
                                            <ui:Button x:Name="BtnEngineStop" Content="■ 끄기" Click="BtnEngineStop_Click" Padding="14,4" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- 연결해 둔 ComfyUI를 엔진으로 쓸 때만 보인다(LoadEngineTab) — [끄기]가 그 ComfyUI 자체를 닫는다는 안내 -->
                                    <TextBlock x:Name="TxtEngineLinked" Style="{StaticResource HintText}" Margin="0,6,0,0" Visibility="Collapsed" Text=""/>
                                    <CheckBox x:Name="ChkPrewarm" Content="앱을 켤 때 엔진도 미리 켠다냥 (첫 채색 대기 없음)"
                                              Foreground="{DynamicResource NekoText}" Margin="0,8,0,0"/>
                                    <CheckBox x:Name="ChkKeepWarm" Content="작업이 끝나도 엔진을 끄지 않는다냥 (다음 작업이 빠르다냥)"
                                              Foreground="{DynamicResource NekoText}" Margin="0,6,0,0"/>
                                    <DockPanel Style="{StaticResource SetRow}" Margin="0,8,0,0">
                                        <TextBlock Text="그래픽카드 종류" Style="{StaticResource SetLabel}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="이 PC에 맞게 조정" Click="BtnAutoTune_Click" Padding="10,4" Margin="8,0,0,0"
                                                   ToolTip="VRAM·RAM을 읽어 해상도·엔진 인자 등을 이 PC에 맞게 바꾼다냥. 바꾸기 전에 목록을 보여 준다냥."/>
                                        <ComboBox x:Name="CmbGpuVendor" MinWidth="240" HorizontalAlignment="Left"
                                                  ToolTip="엔진(ComfyUI)을 어떤 빌드로 받을지다냥. 이미 설치된 엔진은 안 바뀐다냥 — 바꾸려면 포터블 폴더를 지우고 다시 설치하라냥.">
                                            <ComboBoxItem Tag="auto" Content="자동 감지"/>
                                            <ComboBoxItem Tag="nvidia" Content="NVIDIA RTX 20 이상"/>
                                            <ComboBoxItem Tag="nvidia-old" Content="NVIDIA GTX 10 이하 (구형)"/>
                                            <ComboBoxItem Tag="amd" Content="AMD Radeon RX 6000 이상"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtGpuDetected" Style="{StaticResource HintText}" Margin="0,2,0,0" Text=""/>
                                    <!-- 내장 AI(ONNX)의 그래픽카드 사용 (2026-11-09) — ComfyUI 엔진과 별개로, 번역·검열 감지·기본 복원 모델을 DirectML로 돌릴지 -->
                                    <DockPanel Style="{StaticResource SetRow}" Margin="0,8,0,0">
                                        <TextBlock Text="내장 AI 가속" Style="{StaticResource SetLabel}"/>
                                        <ComboBox x:Name="CmbOnnxGpu"
                                                  ToolTip="내장 AI를 그래픽카드로 돌리면 훨씬 빠르다냥(검열 감지 9초 → 1초).&#10;· VRAM을 5GB쯤 써서 '자동'은 6GB 이상이고 엔진 작업이 없을 때만 쓴다냥.&#10;· 오류가 나면 CPU로 바꾼다냥.">
                                            <ComboBoxItem Tag="Auto" Content="자동 — 엔진(ComfyUI)을 안 쓰는 작업에서만 그래픽카드 (권장)"/>
                                            <ComboBoxItem Tag="On" Content="항상 그래픽카드 (VRAM 12GB 이상 권장)"/>
                                            <ComboBoxItem Tag="Off" Content="항상 CPU"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SetHint}" Text="채색과 재생성·커스텀 검열 제거를 맡는 엔진이다냥.&#10;· 앱이 알아서 켜고 끈다냥."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="ComfyUI 화면 · 내 워크플로"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <WrapPanel>
                                        <ui:Button Content="🌐 ComfyUI 화면 열기" Click="BtnOpenComfyUi_Click" Padding="12,5"/>
                                        <ui:Button Content="내장 재생성 레시피를 ComfyUI에 넣는다냥" Click="BtnInstallBundledWf_Click" Padding="12,5" Margin="8,0,0,0"
                                                   ToolTip="내장 재생성 레시피를 ComfyUI 워크플로 목록에 복사한다냥. 커스텀의 출발점으로 쓰라냥."/>
                                        <ui:Button Content="재생성 레시피를 API JSON으로 저장" Click="BtnExportRegenApi_Click" Padding="12,5" Margin="8,0,0,0"
                                                   ToolTip="지금 설정의 재생성 레시피를 API 파일로 저장한다냥 — 참고용이다냥. 그대로 커스텀으로 쓰면 실패한다냥."/>
