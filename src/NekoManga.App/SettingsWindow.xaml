<ui:FluentWindow x:Class="NekoManga.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="설정" Height="640" Width="760"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{StaticResource NekoBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 원고 질감 배경 -->
        <Rectangle Fill="{DynamicResource MangaDots}" Grid.RowSpan="2" IsHitTestVisible="False"/>

        <ui:TitleBar Grid.Row="0" Title="설정 ⚙ (창을 닫으면 저장돼요)" ShowMinimize="False" ShowMaximize="False"/>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="16,4,16,16">

            <!-- ── 채색 ── -->
            <TabItem Header="🎨 채색">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,8,18,8">
                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="품질 · 속도"/></Border>
                        <UniformGrid Columns="2" Rows="4">
                            <DockPanel Margin="0,4">
                                <TextBlock Text="해상도 상한 MP (0.3 ~ 4)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtMegapixels" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="스텝 수 (5 ~ 100)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtSteps" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="CFG (1 ~ 15)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtCfg" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="Denoise (0.1 ~ 1)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtDenoise" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="샘플러" Style="{StaticResource FieldLabel}" Width="130"/>
                                <ComboBox x:Name="CmbSampler" Width="190" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="dpmpp_sde_gpu"/>
                                    <ComboBoxItem Content="dpmpp_2m"/>
                                    <ComboBoxItem Content="euler_ancestral"/>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="선화 합성 % (0 ~ 100)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtLineart" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="시드 (-1=랜덤)" Style="{StaticResource FieldLabel}" Width="130"/>
                                <TextBox x:Name="TxtSeed" Width="130" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <Border/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="샘플러 dpmpp_sde_gpu는 품질 우선(페이지당 ~90초), dpmpp_2m은 속도 우선(~55초). 8GB VRAM이면 해상도 1.5MP를 넘기지 마세요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="컬러 표지로 캐릭터 색 맞추기"/></Border>
                        <DockPanel Margin="0,4">
                            <!-- 미리보기 겸 드롭존 — 표지를 여기에 끌어다 놓으면 등록된다 -->
                            <Border x:Name="RefDropZone" DockPanel.Dock="Left" Width="96" Height="128"
                                    Background="{StaticResource NekoCanvas}" CornerRadius="0" Margin="0,0,10,0"
                                    BorderBrush="{StaticResource NekoStroke}" BorderThickness="1"
                                    AllowDrop="True" Drop="RefDropZone_Drop" DragOver="RefDropZone_DragOver">
                                <Grid>
                                    <TextBlock x:Name="TxtRefDropHint" Text="표지를&#10;끌어다&#10;놓으세요"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" Foreground="{StaticResource NekoHint}"/>
                                    <Image x:Name="ImgRefPreview" Stretch="Uniform" Margin="3"/>
                                </Grid>
                            </Border>
                            <StackPanel>
                                <DockPanel>
                                    <ui:Button x:Name="BtnRefExtract" DockPanel.Dock="Right" Content="🎨 색 뽑기"
                                               Click="BtnRefExtract_Click" Padding="12,4" Margin="8,0,0,0"/>
                                    <ui:Button DockPanel.Dock="Right" Content="찾기" Click="BtnRefBrowse_Click" Padding="12,4" Margin="8,0,0,0"/>
                                    <TextBox x:Name="TxtColorRefImage" TextChanged="TxtColorRefImage_Changed"/>
                                </DockPanel>
                                <TextBox x:Name="TxtColorRefTags" AcceptsReturn="True" Height="66" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="표지 반영 강도 (0 ~ 1.5)" Style="{StaticResource FieldLabel}" Width="150"/>
                                    <TextBox x:Name="TxtRefStrength" Width="64" HorizontalAlignment="Left"/>
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="컬러 표지를 등록하면 ① [색 뽑기]로 머리·눈·의상 색 태그를 뽑아 프롬프트에 넣고(비워 두면 채색 시작 때 자동), ② IPAdapter 모델이 설치돼 있으면 표지의 색·화풍을 모델에 직접 주입해 정밀하게 맞춰요. 반영 강도 0.4~0.6 권장 — 높이면 표지 화풍(배경 색감까지)이 강하게 묻어나요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="캐릭터 태그 (수동)"/></Border>
                        <TextBox x:Name="TxtManualTags" AcceptsReturn="True" Height="54" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="예: blonde hair, amber eyes, navy sailor uniform — 캐릭터 머리·눈 색을 적어주면 채색이 일관돼요. 표지에서 뽑은 태그와 함께 들어가요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="자동 태그에서 뺄 태그"/></Border>
                        <TextBox x:Name="TxtExcludeTags"/>
                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="부정 프롬프트"/></Border>
                        <TextBox x:Name="TxtNegative" AcceptsReturn="True" Height="54" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 검열 제거 ── -->
            <TabItem Header="🙈 검열 제거">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,8,18,8">
                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="제거 방식"/></Border>
                    <ComboBox x:Name="CmbDecensorMode" Width="400" HorizontalAlignment="Left" SelectionChanged="CmbDecensorMode_Changed">
                        <ComboBoxItem Content="기본 — 내장 LaMa 만화판 (빠름, 추가 설치 불필요)" Tag="Basic"/>
                        <ComboBoxItem Content="엔진 LaMa — GPU 복원 (원본 레시피, 엔진 필요)" Tag="ComfyLama"/>
                        <ComboBoxItem Content="재생성 — SDXL로 검열 자리를 그려 넣기 (내장 재생성 레시피, 엔진 필요)" Tag="ComfyRegen"/>
                        <ComboBoxItem Content="커스텀 ComfyUI — 내가 ComfyUI에서 짠 워크플로 파일로 (API JSON, 엔진 필요)" Tag="ComfyCustom"/>
                    </ComboBox>
                    <StackPanel x:Name="PnlCustomDecensor" Visibility="Collapsed">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="워크플로 파일" Style="{StaticResource FieldLabel}" Width="110"/>
                            <ui:Button Content="찾기…" Click="BtnCustomDecensorPick_Click" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0"/>
                            <TextBox x:Name="TxtCustomDecensor" ToolTip="ComfyUI 화면에서 워크플로 메뉴 → Export (API)로 내보낸 JSON"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="되돌릴 범위 px (0 ~ 512)" Style="{StaticResource FieldLabel}" Width="150"/>
                            <TextBox x:Name="TxtCustomReach" Width="70" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="ComfyUI 메뉴 → Export (API)로 내보낸 파일. 규칙: LoadImage 1개(원고, 알파=마스크) + SaveImage 1개(결과). 되돌릴 범위는 마스크 둘레 px (0 = 전체)."/>
                    </StackPanel>
                    <TextBlock x:Name="TxtDecensorModeHint" Style="{StaticResource HintText}" Text=""/>

                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="무엇을 검열로 볼까요"/></Border>
                    <ComboBox x:Name="CmbDecensorTarget" Width="340" HorizontalAlignment="Left"
                              SelectionChanged="CmbDecensorTarget_Changed">
                        <ComboBoxItem Tag="Auto" Content="자동 (AI 감지) — 권장"/>
                        <ComboBoxItem Tag="BlackBar" Content="검은색 막대 (먹줄) — 수동"/>
                        <ComboBoxItem Tag="WhiteBar" Content="흰색 막대 — 수동"/>
                        <ComboBoxItem Tag="Mosaic" Content="모자이크 (격자) — 수동"/>
                        <ComboBoxItem Tag="Color" Content="색 검열 (파란·빨간 막대·틴트 모자이크) — 수동"/>
                    </ComboBox>

                    <!-- AI 감지 상태 카드 — 모델 유무에 따라 안내가 바뀐다 -->
                    <Border x:Name="CardCensorAi" Background="{DynamicResource NekoCard}"
                            BorderBrush="{DynamicResource NekoStroke}" BorderThickness="2" CornerRadius="0"
                            Padding="14,10" Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse x:Name="DotCensorAi" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCensorAi" Margin="10,0,0,0" FontWeight="SemiBold"
                                           Foreground="{DynamicResource NekoText}" VerticalAlignment="Center"
                                           Text="검열 감지 AI 상태 확인 중..."/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="이 앱 전용으로 직접 학습한 모델이에요 — 흰 막대·흰 박스·단색 밀기·검은 막대·모자이크를 한 번에 찾고, 말풍선이나 체크무늬 옷 같은 건 검열로 보지 않아요. 수동 모드는 AI가 놓치는 특이한 검열을 직접 겨냥할 때만 쓰세요."/>
                            <ui:Button x:Name="BtnInstallCensorAi" Content="⬇ 검열 감지 AI 설치"
                                       Click="BtnOpenSetup_Click" Padding="14,6" Margin="0,10,0,0"
                                       HorizontalAlignment="Left" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 수동 모드 전용 세부값 — 자동(AI)에서는 쓰이지 않으므로 접어 둔다 -->
                    <ui:Button x:Name="BtnManualDetect" Content="▸ 수동 감지 세부 설정"
                               Click="BtnManualDetect_Click" Margin="0,14,0,0" Padding="14,6"/>
                    <StackPanel x:Name="PnlManualDetect" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="아래 값들은 위에서 '수동'을 고른 경우에만 쓰여요 (AI 자동 감지에는 영향 없음). 수동은 한 번에 한 종류만 추적해요 — 섞으면 서로의 오탐이 결과를 망가뜨려요."/>
                    <UniformGrid Columns="2" Rows="1" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Text="막대 최소 비율 (1 ~ 10)" Style="{StaticResource FieldLabel}" Width="160"/>
                            <TextBox x:Name="TxtBarAspect" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="막대 최소 크기 (50 ~ 500000)" Style="{StaticResource FieldLabel}" Width="160"/>
                            <TextBox x:Name="TxtBarMinArea" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="비율은 가로세로 길이의 비(1.8이면 긴 쪽이 짧은 쪽의 1.8배 이상). 정사각형에 가까운 검열도 잡으려면 1.2까지 낮춰보세요. 크기는 px² 단위."/>

                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="모자이크 감지 세부 (수동)"/></Border>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="블록 크기 px (2 ~ 64)" Style="{StaticResource FieldLabel}" Width="160"/>
                        <TextBox x:Name="TxtBlockSize" Width="90" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="모자이크 격자 한 칸의 픽셀 크기. 이미지를 확대해서 재보세요 (보통 4~16)."/>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="감지 민감도 (1 ~ 80)" Style="{StaticResource FieldLabel}" Width="160"/>
                        <TextBox x:Name="TxtThreshold" Width="90" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="낮을수록 더 많은 영역을 모자이크로 판단해요 (기본 15)."/>
                    </StackPanel>

                    <!-- 마스크 확장은 AI·수동 공통 (복원 경계를 자연스럽게) -->
                    <DockPanel Margin="0,14,0,0">
                        <TextBlock Text="마스크 확장 px (0 ~ 64)" Style="{StaticResource FieldLabel}" Width="160"/>
                        <TextBox x:Name="TxtMaskGrow" Width="90" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="감지된 영역 둘레를 조금 더 넓게 지워 경계를 자연스럽게 해요 (AI·수동 공통)."/>
                    <CheckBox x:Name="ChkReview" Content="제거 전에 감지된 마스크를 직접 확인·추가하기 (검토 창)" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="모든 페이지의 검열을 먼저 찾은 뒤 검토 창이 떠요. 놓친 검열은 브러시·다각형으로 칠하고, 잘못 잡힌 곳은 지우고 나서 제거를 시작해요."/>
                    <CheckBox x:Name="ChkCollect" Content="검토에서 고친 마스크를 학습 재료로 모으기 (내 PC에만 저장)" Margin="0,8,0,0"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="원고·자동 감지·최종 마스크를 %AppData%\NekoManga\training\corrections 에 저장해요. 모인 재료로 감지 모델을 다시 학습하면 내 원고에 맞게 좋아져요."/>

                    <Border Style="{StaticResource MangaTag}" Margin="0,14,0,0"><TextBlock Style="{StaticResource MangaTagText}" Text="자가 학습 (반자동)"/></Border>
                    <CheckBox x:Name="ChkSelfTrain" Content="자가 학습 기능 켜기" Margin="0,6,0,0" Checked="ChkSelfTrain_Changed" Unchecked="ChkSelfTrain_Changed"/>
                    <StackPanel x:Name="PnlSelfTrain" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="모은 재료로 감지 모델을 짧게 미세조정하고, 보류해 둔 페이지에서 전/후를 비교해 보여 줘요. [적용]을 눌러야 모델이 바뀌고 언제든 되돌릴 수 있어요. 학습 중엔 GPU를 쓰고(엔진은 잠시 꺼요) 수 분~수십 분 걸려요."/>
                        <TextBlock x:Name="TxtTrainMaterial" Style="{StaticResource HintText}" Margin="0,4,0,0" Text=""/>
                        <WrapPanel Margin="0,6,0,0">
                            <ui:Button x:Name="BtnSelfTrain" Content="🎓 지금까지 모은 재료로 학습" Click="BtnSelfTrain_Click" Padding="12,5"/>
                            <ui:Button x:Name="BtnSelfTrainStop" Content="중단" Click="BtnSelfTrainStop_Click" Padding="12,5" Margin="8,0,0,0" IsEnabled="False"/>
                            <ui:Button x:Name="BtnSelfApply" Content="✔ 적용" Click="BtnSelfApply_Click" Padding="12,5" Margin="8,0,0,0" IsEnabled="False"/>
                            <ui:Button x:Name="BtnSelfRollback" Content="↶ 이전 모델로 되돌리기" Click="BtnSelfRollback_Click" Padding="12,5" Margin="8,0,0,0" IsEnabled="False"/>
                            <ui:Button Content="재료 폴더 열기" Click="BtnOpenCorrections_Click" Padding="12,5" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtTrainStatus" Style="{StaticResource HintText}" Margin="0,6,0,0" Text="" TextWrapping="Wrap"/>
                        <UniformGrid Columns="2" Rows="2" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock Text="에폭 (1 ~ 50)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtSelfEpochs" Width="70" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="학습률 (0.00001 ~ 0.01)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtSelfLr" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="동결 층 (0 ~ 22)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtSelfFreeze" Width="70" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="최소 재료 쪽수 (5 ~ 500)" Style="{StaticResource FieldLabel}" Width="166"/>
                                <TextBox x:Name="TxtSelfMinPages" Width="70" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="기본값(5에폭·0.0002·백본 동결)은 재료가 적을 때 기존 실력을 잊지 않게 보수적으로 잡은 값이에요."/>
                    </StackPanel>
                    <CheckBox x:Name="ChkBubbleFilter" Content="흰 말풍선 필터 (글자 블록과 겹치는 흰 검출 버리기)" Margin="0,10,0,0"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="기본 꺼짐. 켜면 흰 말풍선 오탐은 줄지만 진짜 흰선 검열도 일부 지워져요. 말풍선이 자꾸 지워지는 원고에서만."/>

                    <!-- 고급: 워크플로를 아는 사용자용 — 접힌 상태가 기본 -->
                    <ui:Button x:Name="BtnDecensorAdv" Content="▸ 고급 옵션 — 워크플로 직접 제어"
                               Click="BtnDecensorAdv_Click" Margin="0,18,0,0" Padding="14,6"/>
                    <StackPanel x:Name="PnlDecensorAdv" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="ComfyUI 워크플로에 들어가는 값 그대로예요. 기본값은 원본 레시피 — 바꾼 값은 다음 작업부터 적용돼요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="엔진 LaMa 워크플로"/></Border>
                        <UniformGrid Columns="2" Rows="1" Margin="0,4,0,0">
                            <DockPanel>
                                <TextBlock Text="마스크 확장 (0 ~ 64)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtAdvLamaGrow" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="마스크 블러 (0 ~ 64)" Style="{StaticResource FieldLabel}" Width="150"/>
                                <TextBox x:Name="TxtAdvLamaBlur" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="LayerUtility: LaMa 노드의 mask_grow / mask_blur. 원본 레시피는 8 · 8이에요."/>

                        <Border Style="{StaticResource MangaTag}" Margin="0,12,0,0"><TextBlock Style="{StaticResource MangaTagText}" Text="재생성 워크플로 (SDXL)"/></Border>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="체크포인트 파일" Style="{StaticResource FieldLabel}" Width="130"/>
                            <ui:Button Content="찾기…" Click="BtnRegenCkptPick_Click" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0"/>
                            <TextBox x:Name="TxtRegenCkpt" IsReadOnly="True"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="ControlNet 파일" Style="{StaticResource FieldLabel}" Width="130"/>
