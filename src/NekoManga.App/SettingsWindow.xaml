<ui:FluentWindow x:Class="NekoManga.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="설정" Height="640" Width="760"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{StaticResource NekoBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 원고 질감 배경 -->
        <Rectangle Fill="{DynamicResource MangaDots}" Grid.RowSpan="2" IsHitTestVisible="False"/>

        <ui:TitleBar Grid.Row="0" Title="설정 ⚙ (창을 닫으면 저장돼요)" ShowMinimize="False" ShowMaximize="False"/>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="16,4,16,16">

            <!-- ── 채색 ── -->
            <TabItem Header="🎨 채색">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="품질 · 속도"/></Border>
                        <UniformGrid Columns="2" Rows="4">
                            <DockPanel Margin="0,4">
                                <TextBlock Text="해상도 상한 (MP)" Style="{StaticResource FieldLabel}" Width="130"/>
                                <TextBox x:Name="TxtMegapixels" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="스텝 수" Style="{StaticResource FieldLabel}" Width="130"/>
                                <TextBox x:Name="TxtSteps" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="CFG" Style="{StaticResource FieldLabel}" Width="130"/>
                                <TextBox x:Name="TxtCfg" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="Denoise" Style="{StaticResource FieldLabel}" Width="130"/>
                                <TextBox x:Name="TxtDenoise" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="샘플러" Style="{StaticResource FieldLabel}" Width="130"/>
                                <ComboBox x:Name="CmbSampler" Width="190" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="dpmpp_sde_gpu"/>
                                    <ComboBoxItem Content="dpmpp_2m"/>
                                    <ComboBoxItem Content="euler_ancestral"/>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="선화 합성 %" Style="{StaticResource FieldLabel}" Width="130"/>
                                <TextBox x:Name="TxtLineart" Width="90" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="시드 (-1=랜덤)" Style="{StaticResource FieldLabel}" Width="130"/>
                                <TextBox x:Name="TxtSeed" Width="130" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <Border/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="샘플러 dpmpp_sde_gpu는 품질 우선(페이지당 ~90초), dpmpp_2m은 속도 우선(~55초). 8GB VRAM이면 해상도 1.5MP를 넘기지 마세요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="컬러 표지로 캐릭터 색 맞추기"/></Border>
                        <DockPanel Margin="0,4">
                            <!-- 미리보기 겸 드롭존 — 표지를 여기에 끌어다 놓으면 등록된다 -->
                            <Border x:Name="RefDropZone" DockPanel.Dock="Left" Width="96" Height="128"
                                    Background="{StaticResource NekoCanvas}" CornerRadius="0" Margin="0,0,10,0"
                                    BorderBrush="{StaticResource NekoStroke}" BorderThickness="1"
                                    AllowDrop="True" Drop="RefDropZone_Drop" DragOver="RefDropZone_DragOver">
                                <Grid>
                                    <TextBlock x:Name="TxtRefDropHint" Text="표지를&#10;끌어다&#10;놓으세요"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" Foreground="{StaticResource NekoHint}"/>
                                    <Image x:Name="ImgRefPreview" Stretch="Uniform" Margin="3"/>
                                </Grid>
                            </Border>
                            <StackPanel>
                                <DockPanel>
                                    <ui:Button x:Name="BtnRefExtract" DockPanel.Dock="Right" Content="🎨 색 뽑기"
                                               Click="BtnRefExtract_Click" Padding="12,4" Margin="8,0,0,0"/>
                                    <ui:Button DockPanel.Dock="Right" Content="찾기" Click="BtnRefBrowse_Click" Padding="12,4" Margin="8,0,0,0"/>
                                    <TextBox x:Name="TxtColorRefImage" TextChanged="TxtColorRefImage_Changed"/>
                                </DockPanel>
                                <TextBox x:Name="TxtColorRefTags" AcceptsReturn="True" Height="66" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="표지 반영 강도" Style="{StaticResource FieldLabel}" Width="110"/>
                                    <TextBox x:Name="TxtRefStrength" Width="64" HorizontalAlignment="Left"/>
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="컬러 표지를 등록하면 ① [색 뽑기]로 머리·눈·의상 색 태그를 뽑아 프롬프트에 넣고(비워 두면 채색 시작 때 자동), ② IPAdapter 모델이 설치돼 있으면 표지의 색·화풍을 모델에 직접 주입해 정밀하게 맞춰요. 반영 강도 0.4~0.6 권장 — 높이면 표지 화풍(배경 색감까지)이 강하게 묻어나요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="캐릭터 태그 (수동)"/></Border>
                        <TextBox x:Name="TxtManualTags" AcceptsReturn="True" Height="54" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="예: blonde hair, amber eyes, navy sailor uniform — 캐릭터 머리·눈 색을 적어주면 채색이 일관돼요. 표지에서 뽑은 태그와 함께 들어가요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="자동 태그에서 뺄 태그"/></Border>
                        <TextBox x:Name="TxtExcludeTags"/>
                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="부정 프롬프트"/></Border>
                        <TextBox x:Name="TxtNegative" AcceptsReturn="True" Height="54" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 검열 제거 ── -->
            <TabItem Header="🙈 검열 제거">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="제거 방식"/></Border>
                    <ComboBox x:Name="CmbDecensorMode" Width="400" HorizontalAlignment="Left">
                        <ComboBoxItem Content="기본 — 내장 LaMa (빠름, 추가 설치 불필요)" Tag="Basic"/>
                        <ComboBoxItem Content="엔진 LaMa — GPU 복원 (원본 레시피, 엔진 필요)" Tag="ComfyLama"/>
                        <ComboBoxItem Content="강력 — SDXL 재생성 (다시 그리기, 엔진 필요)" Tag="Strong"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="기본·엔진 LaMa는 주변과 어울리게 '메우는' 방식 — 먹줄·흰줄·가벼운 모자이크에 적합해요. 엔진 LaMa는 ComfyUI에서 쓰던 원본 레시피(GPU, 확장 8·블러 8) 그대로예요. 강력은 SDXL이 그 자리를 '다시 그리는' 방식이라 면적이 넓거나 뭉개짐이 심할 때 써요."/>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="강력 모드 강도" Style="{StaticResource FieldLabel}" Width="130"/>
                        <TextBox x:Name="TxtStrongDenoise" Width="90" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="0.5~0.9. 높을수록 많이 다시 그려요 (기본 0.75)."/>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="강력 모드 시드" Style="{StaticResource FieldLabel}" Width="130"/>
                        <TextBox x:Name="TxtDecensorSeed" Width="140" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="같은 원고를 다시 돌려도 같은 그림이 나오게 하는 값이에요. -1로 두면 매번 다르게 그려져요. 마음에 드는 결과가 나오면 그 시드를 적어 두세요."/>

                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="무엇을 검열로 볼까요"/></Border>
                    <ComboBox x:Name="CmbDecensorTarget" Width="300" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="BlackBar" Content="검은색 막대 (먹줄)"/>
                        <ComboBoxItem Tag="WhiteBar" Content="흰색 막대"/>
                        <ComboBoxItem Tag="Mosaic" Content="모자이크 (격자)"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="정확성을 위해 한 번에 한 종류만 추적해요 — 여러 종류를 섞으면 서로의 오탐이 결과를 망가뜨려요. 원고의 검열 방식에 맞게 골라주세요. 흰색 막대는 주변 흰 살결과 붙어 자동으로는 놓치기 쉬워요 — 놓친 건 [결과 보기·수정]에서 '흰 부분만'으로 직접 지울 수 있어요."/>
                    <UniformGrid Columns="2" Rows="1" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Text="막대 최소 비율" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtBarAspect" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="막대 최소 크기" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtBarMinArea" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="비율은 가로세로 길이의 비(1.8이면 긴 쪽이 짧은 쪽의 1.8배 이상). 정사각형에 가까운 검열도 잡으려면 1.2까지 낮춰보세요. 크기는 px² 단위."/>

                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="모자이크 감지 세부"/></Border>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="블록 크기 (px)" Style="{StaticResource FieldLabel}" Width="130"/>
                        <TextBox x:Name="TxtBlockSize" Width="90" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="모자이크 격자 한 칸의 픽셀 크기. 이미지를 확대해서 재보세요 (보통 4~16)."/>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="감지 민감도" Style="{StaticResource FieldLabel}" Width="130"/>
                        <TextBox x:Name="TxtThreshold" Width="90" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="낮을수록 더 많은 영역을 모자이크로 판단해요 (기본 15)."/>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="마스크 확장 (px)" Style="{StaticResource FieldLabel}" Width="130"/>
                        <TextBox x:Name="TxtMaskGrow" Width="90" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="감지된 영역 둘레를 조금 더 넓게 지워 경계를 자연스럽게 해요."/>

                    <!-- 고급: 워크플로를 아는 사용자용 — 접힌 상태가 기본 -->
                    <ui:Button x:Name="BtnDecensorAdv" Content="▸ 고급 옵션 — 워크플로 직접 제어"
                               Click="BtnDecensorAdv_Click" Margin="0,18,0,0" Padding="14,6"/>
                    <StackPanel x:Name="PnlDecensorAdv" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="ComfyUI 워크플로에 들어가는 값 그대로예요. 기본값은 원본 레시피 — 바꾼 값은 다음 작업부터 적용돼요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="강력(SDXL) 워크플로"/></Border>
                        <UniformGrid Columns="2" Rows="2" Margin="0,4,0,0">
                            <DockPanel Margin="0,4">
                                <TextBlock Text="스텝 수" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvStrongSteps" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="CFG" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvStrongCfg" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="샘플러" Style="{StaticResource FieldLabel}" Width="110"/>
                                <ComboBox x:Name="CmbAdvStrongSampler" Width="170" IsEditable="True" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="dpmpp_2m"/>
                                    <ComboBoxItem Content="dpmpp_sde_gpu"/>
                                    <ComboBoxItem Content="euler"/>
                                    <ComboBoxItem Content="euler_ancestral"/>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="스케줄러" Style="{StaticResource FieldLabel}" Width="110"/>
                                <ComboBox x:Name="CmbAdvStrongScheduler" Width="170" IsEditable="True" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="karras"/>
                                    <ComboBoxItem Content="normal"/>
                                    <ComboBoxItem Content="sgm_uniform"/>
                                    <ComboBoxItem Content="exponential"/>
                                </ComboBox>
                            </DockPanel>
                        </UniformGrid>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="긍정 프롬프트" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtAdvStrongPositive" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="부정 프롬프트" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtAdvStrongNegative" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="합성 여유 (px)" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtAdvCompositeGrow" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="다시 그린 조각을 원본에 붙일 때 마스크를 몇 px 넓혀 합성할지(GrowMask). 경계 티가 나면 올려보세요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="엔진 LaMa 워크플로"/></Border>
                        <UniformGrid Columns="2" Rows="1" Margin="0,4,0,0">
                            <DockPanel>
                                <TextBlock Text="마스크 확장" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvLamaGrow" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="마스크 블러" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvLamaBlur" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="LayerUtility: LaMa 노드의 mask_grow / mask_blur. 원본 레시피는 8 · 8이에요."/>

                        <ui:Button Content="기본값 복원" Click="BtnDecensorAdvReset_Click" Margin="0,10,0,0" Padding="12,5"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 번역 ── -->
            <TabItem Header="💬 번역">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="번역 엔진"/></Border>
                    <ComboBox x:Name="CmbTranslator" Width="300" HorizontalAlignment="Left"
                              SelectionChanged="CmbTranslator_SelectionChanged">
                        <ComboBoxItem Content="Google (무료, 키 불필요)" Tag="Google"/>
                        <ComboBoxItem Content="DeepL (API 키 필요)" Tag="DeepL"/>
                        <ComboBoxItem Content="DeepSeek (AI 번역 · API 키 필요)" Tag="DeepSeek"/>
                        <ComboBoxItem Content="Grok / xAI (AI 번역 · API 키 필요)" Tag="Grok"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="DeepSeek·Grok은 문맥을 이해하는 AI 번역이라 말투·뉘앙스가 자연스러워요 (유료 API, 보통 저렴)."/>

                    <!-- DeepL -->
                    <StackPanel x:Name="PanelDeepL">
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="DeepL API 키" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtDeepLKey" Width="360" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="deepl.com 무료 플랜 키(…:fx)도 돼요 (월 50만 자)."/>
                    </StackPanel>

                    <!-- DeepSeek -->
                    <StackPanel x:Name="PanelDeepSeek">
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="DeepSeek 키" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtDeepSeekKey" Width="360" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="모델" Style="{StaticResource FieldLabel}" Width="110"/>
                            <ComboBox x:Name="CmbDeepSeekModel" Width="260" HorizontalAlignment="Left" IsEditable="True">
                                <ComboBoxItem Content="deepseek-flash"/>
                                <ComboBoxItem Content="deepseek-v4-pro"/>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="platform.deepseek.com에서 키 발급. 번역은 deepseek-flash(저렴·빠름)로 충분하고, 더 정교한 의역은 deepseek-v4-pro. 비우면 deepseek-flash."/>
                    </StackPanel>

                    <!-- Grok -->
                    <StackPanel x:Name="PanelGrok">
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Grok(xAI) 키" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtGrokKey" Width="360" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="모델" Style="{StaticResource FieldLabel}" Width="110"/>
                            <ComboBox x:Name="CmbGrokModel" Width="260" HorizontalAlignment="Left" IsEditable="True">
                                <ComboBoxItem Content="grok-4.3"/>
                                <ComboBoxItem Content="grok-4.7"/>
                                <ComboBoxItem Content="grok-build-0.1"/>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="console.x.ai에서 키 발급. 번역은 grok-4.3(저렴)이면 충분하고, 최고 품질은 grok-4.7, 가장 저렴한 건 grok-build-0.1. 비우면 grok-4.3."/>
                    </StackPanel>
                    <UniformGrid Columns="2" Rows="1" Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock Text="원본 언어" Style="{StaticResource FieldLabel}" Width="90"/>
                            <ComboBox x:Name="CmbSource" Width="170" HorizontalAlignment="Left">
                                <ComboBoxItem Content="일본어" Tag="ja"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="번역 언어" Style="{StaticResource FieldLabel}" Width="90"/>
                            <ComboBox x:Name="CmbTarget" Width="170" HorizontalAlignment="Left">
                                <ComboBoxItem Content="한국어" Tag="ko"/>
                                <ComboBoxItem Content="영어" Tag="en"/>
                            </ComboBox>
                        </DockPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="글자 인식(manga-ocr)이 일본어 특화라 원본 언어는 일본어만 지원해요. 감지→인식→번역→글자 지우기 전부 내장 AI로 처리돼서 따로 설치할 게 없어요."/>

                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="식자 — 말풍선 글자 모양"/></Border>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="글꼴" Style="{StaticResource FieldLabel}" Width="110"/>
                        <ComboBox x:Name="CmbLetterFont" Width="240" HorizontalAlignment="Left" IsEditable="True"/>
                        <CheckBox x:Name="ChkLetterBold" Content="굵게" Foreground="{StaticResource NekoText}"
                                  VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </DockPanel>
                    <UniformGrid Columns="2" Rows="1" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Text="크기 배율" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtLetterSize" Width="70" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="글자 색" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtLetterColor" Width="110" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Rows="1" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Text="외곽선 두께" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtLetterOutline" Width="70" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="외곽선 색" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtLetterOutlineColor" Width="110" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="크기 배율 1.0 = 원문 글자 크기 그대로 (말풍선을 넘치면 자동으로 줄어요). 글자 색은 #RRGGBB — 비우면 원문 색을 따라가요. 외곽선 두께 1.0 = 기본, 0 = 외곽선 없음. 외곽선 덕에 어두운 배경에서도 글자가 읽혀요."/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 엔진 (ComfyUI 수명·모델 관리 — 초보자용) ── -->
            <TabItem Header="⚙ 엔진">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="채색 엔진"/></Border>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="채색과 강력 검열제거를 담당하는 엔진이에요. 창 없이 뒤에서 돌아가고, 앱이 알아서 켜고 꺼요 — 직접 실행할 일이 없어요."/>
                    <Border Background="{StaticResource NekoCard}" BorderBrush="{StaticResource NekoStroke}" BorderThickness="2" CornerRadius="0" Padding="14,10" Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse x:Name="DotEngine" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEngineState" Text="상태 확인 중..." Margin="10,0,0,0"
                                           Foreground="{StaticResource NekoText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button x:Name="BtnEngineStart" Content="▶ 켜기" Click="BtnEngineStart_Click" Padding="14,4"/>
                                    <ui:Button x:Name="BtnEngineStop" Content="■ 끄기" Click="BtnEngineStop_Click" Padding="14,4" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <CheckBox x:Name="ChkPrewarm" Content="앱을 켤 때 엔진도 미리 켜 두기 (첫 채색 대기 없음)"
                                      Foreground="{StaticResource NekoText}" Margin="0,10,0,0"/>
                            <CheckBox x:Name="ChkKeepWarm" Content="작업이 끝나도 엔진을 꺼두지 않기 (다음 작업이 빨라져요)"
                                      Foreground="{StaticResource NekoText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="채색 모델"/></Border>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="그림을 그리는 모델이에요. 더 좋은 모델이 나오면 파일을 가져오거나 주소로 받아서 바꿔 끼울 수 있어요."/>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="그림 모델" Style="{StaticResource FieldLabel}" Width="110"/>
                        <ui:Button Content="↻" Click="BtnModelsRefresh_Click" DockPanel.Dock="Right" Padding="10,4" ToolTip="목록 새로고침"/>
                        <ui:Button Content="파일 가져오기" Click="BtnCkptImport_Click" DockPanel.Dock="Right" Padding="10,4" Margin="8,0"/>
                        <ComboBox x:Name="CmbCheckpoint"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="주소로 받기" Style="{StaticResource FieldLabel}" Width="110"/>
                        <ui:Button x:Name="BtnCkptDownload" Content="⬇ 받기" Click="BtnCkptDownload_Click" DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0"/>
                        <TextBox x:Name="TxtCkptUrl" ToolTip="civitai·huggingface 다운로드 주소를 붙여넣으세요"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtCkptStatus" Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="civitai 주소는 로그인 모델이면 구성요소 탭의 API 키를 써요. 받은 모델은 위 목록에서 골라요."/>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="선화 안내 모델" Style="{StaticResource FieldLabel}" Width="110"/>
                        <ComboBox x:Name="CmbControlNet"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="원고의 선을 따라 그리게 잡아주는 모델(ControlNet)이에요. 보통 바꿀 일이 없어요."/>

                    <!-- 고급: 엔진 실행·채색 워크플로 세부 — 접힌 상태가 기본 -->
                    <ui:Button x:Name="BtnEngineAdv" Content="▸ 고급 옵션 — 엔진·워크플로 직접 제어"
                               Click="BtnEngineAdv_Click" Margin="0,18,0,0" Padding="14,6"/>
                    <StackPanel x:Name="PnlEngineAdv" Visibility="Collapsed">
                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="엔진 실행"/></Border>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="포트" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtAdvPort" Width="90" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="추가 실행 인자" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtAdvExtraArgs"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="main.py 뒤에 그대로 붙어요 — 예: --lowvram (VRAM 부족), --cpu, --fast. 엔진을 껐다 켜면 적용돼요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="채색 ControlNet 2단"/></Border>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Text="원본 레시피: 선화(lineart)가 0~60% 구간, 스케치(scribble)가 60~100% 구간을 맡아요. 구간은 0~1."/>
                        <UniformGrid Columns="2" Rows="2" Margin="0,4,0,0">
                            <DockPanel Margin="0,4">
                                <TextBlock Text="선화 강도" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvCnLineStr" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="선화 구간 끝" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvCnLineEnd" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="스케치 강도" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvCnScrStr" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="스케치 구간 시작" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvCnScrStart" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </UniformGrid>
                        <UniformGrid Columns="2" Rows="1" Margin="0,4,0,0">
                            <DockPanel>
                                <TextBlock Text="전처리 해상도" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvPreRes" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="XDoG 임계값" Style="{StaticResource FieldLabel}" Width="110"/>
                                <TextBox x:Name="TxtAdvXdog" Width="80" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="전처리 해상도(기본 1280)는 선화/스케치 추출 크기 — 높이면 가는 선을 더 잡지만 느려져요. XDoG 임계값(기본 32)은 스케치 선이 얼마나 진해야 잡을지예요."/>

                        <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="표지 주입 (IPAdapter)"/></Border>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="적용 끝 지점" Style="{StaticResource FieldLabel}" Width="110"/>
                            <TextBox x:Name="TxtAdvIpaEnd" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="0~1 (기본 0.9). 낮추면 마무리 단계에서 표지 영향이 빠져 원고 본연의 톤이 살아나요."/>

                        <ui:Button Content="기본값 복원" Click="BtnEngineAdvReset_Click" Margin="0,10,0,0" Padding="12,5"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 구성요소 ── -->
            <TabItem Header="📦 구성요소">
                <StackPanel Margin="8">
                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="설치 경로"/></Border>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="구성요소 위치" Style="{StaticResource FieldLabel}" Width="130"/>
                        <TextBox x:Name="TxtRuntimeRoot" IsReadOnly="True"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="결과물 저장" Style="{StaticResource FieldLabel}" Width="130"/>
                        <ui:Button DockPanel.Dock="Right" Content="선택" Click="BtnPickOutput_Click" Padding="12,4" Margin="8,0,0,0"/>
                        <TextBox x:Name="TxtOutputRoot"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="비워두면 원본 폴더 옆에 '폴더명_neko'로 저장돼요."/>

                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="기존 설치 연결"/></Border>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="ComfyUI 경로" Style="{StaticResource FieldLabel}" Width="130"/>
                        <TextBox x:Name="TxtLinkedComfy"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="이미 설치해 둔 ComfyUI portable이 있으면 경로를 넣어 재다운로드(11GB)를 건너뛰어요. 채색·강력 검열제거에만 필요해요."/>

                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="civitai API 키 (선택)"/></Border>
                    <TextBox x:Name="TxtCivitaiKey"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="채색 모델 다운로드가 로그인 오류로 실패할 때만 필요해요. civitai.com → 계정 설정 → API Keys."/>

                    <ui:Button Content="구성요소 설치 창 열기" Click="BtnOpenSetup_Click" Margin="0,14,0,0" Padding="16,8"/>
                </StackPanel>
            </TabItem>

            <!-- ── 정보 ── -->
            <TabItem Header="ℹ 정보">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                        <Image Source="{StaticResource NekoLogo}" Width="46" Height="46" Margin="0,0,12,0"/>
                        <TextBlock Text="NekoManga" FontSize="24" FontWeight="ExtraBold"
                                   Foreground="{StaticResource NekoText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAboutVersion" Style="{StaticResource HintText}"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="흑백 만화 자동 채색 + 검열 제거 + 번역 식자 올인원."/>
                    <ui:Button Content="GitHub 열기" Click="BtnGitHub_Click" Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Left"/>

                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="화면 테마"/></Border>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbThemeLight" Content="☀ 화이트 (원고지)" IsChecked="True"
                                     Foreground="{StaticResource NekoText}" Margin="0,0,18,0"
                                     Checked="Theme_Changed"/>
                        <RadioButton x:Name="RbThemeDark" Content="🌙 다크 (먹지)"
                                     Foreground="{StaticResource NekoText}"
                                     Checked="Theme_Changed"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="고르는 즉시 모든 창에 적용돼요."/>
                    <Border Style="{StaticResource MangaTag}"><TextBlock Style="{StaticResource MangaTagText}" Text="프로그램 삭제"/></Border>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="앱과 바로가기를 제거해요. 내려받은 구성요소 폴더는 용량이 커서 자동으로 지우지 않아요 — 삭제 후 직접 지워주세요."/>
                    <ui:Button x:Name="BtnUninstall" Content="🗑 NekoManga 삭제하기" Click="BtnUninstall_Click"
                               Appearance="Danger" Margin="0,8,0,0" Padding="16,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
