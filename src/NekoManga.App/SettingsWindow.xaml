                                    <UniformGrid Columns="2" Rows="2" Margin="0,4,0,0">
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="정렬" Style="{StaticResource SetLabel}"/>
                                            <ComboBox x:Name="CmbLetterAlign" MinWidth="110" HorizontalAlignment="Left">
                                                <ComboBoxItem Tag="Left" Content="왼쪽"/>
                                                <ComboBoxItem Tag="Center" Content="가운데" IsSelected="True"/>
