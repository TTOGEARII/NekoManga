                                        <ComboBox x:Name="CmbCheckpoint"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SetRow}">
                                        <TextBlock Text="주소로 받기" Style="{StaticResource SetLabel}"/>
                                        <ui:Button x:Name="BtnCkptDownload" Content="⬇ 받기" Click="BtnCkptDownload_Click" DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0"/>
                                        <TextBox x:Name="TxtCkptUrl" ToolTip="civitai·huggingface 다운로드 주소를 붙여넣으라냥"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtCkptStatus" Style="{StaticResource HintText}" Margin="0,2,0,0"
                                               Text="civitai 로그인 모델은 구성요소 탭의 API 키를 쓴다냥.&#10;· 받은 모델은 위 목록에서 고른다냥."/>
                                    <DockPanel Style="{StaticResource SetRow}" Margin="0,8,0,0">
                                        <TextBlock Text="선화 안내 모델" Style="{StaticResource SetLabel}"/>
                                        <ComboBox x:Name="CmbControlNet" ToolTip="원고 선을 따라 그리게 잡아 주는 모델(ControlNet)이다냥.&#10;· 보통 안 바꾼다냥."/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SetHint}" Text="그림을 그리는 모델이다냥.&#10;· 파일을 가져오거나 주소로 받아 바꿀 수 있다냥."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 고급: 엔진 실행·채색 워크플로 세부 — 접힌 상태가 기본 -->
                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <ToggleButton x:Name="BtnEngineAdv" Style="{StaticResource SetCardToggle}" Content="고급 옵션 — 엔진·워크플로 직접 제어"/>
                                <StackPanel x:Name="PnlEngineAdv" Style="{StaticResource SideBody}"
                                            Visibility="{Binding IsChecked, ElementName=BtnEngineAdv, Converter={StaticResource BoolToVis}}">
