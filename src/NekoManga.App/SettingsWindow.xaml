                                            <TextBlock Text="0 ~ 64" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="조각 그리기 CN 강도" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtRegenInpaintCnStr" Width="70" HorizontalAlignment="Left" ToolTip="1단계(조각 인페인트)의 ControlNet 강도다냥. 기본 0.25 — 0이면 주변 선의 안내 없이 채워 어색할 수 있고, 올릴수록 막대 자리가 평평한 흰 칠로 메워질 수 있다냥"/>
                                            <TextBlock Text="0 ~ 2" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="흰 조각 다시 그리기" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtRegenWhiteRetries" Width="70" HorizontalAlignment="Left" ToolTip="그린 결과에서 막대 자리가 평평한 흰 칠로 남은 조각이 있으면 새 시드로 이만큼 더 그려 덜 흰 것을 고른다냥. 기본 2 — 한 번 더 그릴 때마다 1~2분이 든다냥. 0이면 끈다냥. 시드를 고정한 장은 다시 그리지 않는다냥"/>
                                            <TextBlock Text="0 ~ 5" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <Border/>
                                    </UniformGrid>
                                    <DockPanel Style="{StaticResource SetRow}">
                                        <TextBlock Text="조각 그리기 ControlNet" Style="{StaticResource SetLabel}"/>
