                                                <TextBox DockPanel.Dock="Left" x:Name="TxtSelfEpochs" Width="70" HorizontalAlignment="Left"/>
                                                <TextBlock Text="1 ~ 50" Style="{StaticResource SetRange}"/>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource SetRow}">
                                                <TextBlock Text="학습률" Style="{StaticResource SetLabel}"/>
                                                <TextBox DockPanel.Dock="Left" x:Name="TxtSelfLr" Width="90" HorizontalAlignment="Left"/>
                                                <TextBlock Text="0.00001 ~ 0.01" Style="{StaticResource SetRange}"/>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource SetRow}">
                                                <TextBlock Text="동결 층" Style="{StaticResource SetLabel}"/>
                                                <TextBox DockPanel.Dock="Left" x:Name="TxtSelfFreeze" Width="70" HorizontalAlignment="Left"/>
                                                <TextBlock Text="0 ~ 22" Style="{StaticResource SetRange}"/>
