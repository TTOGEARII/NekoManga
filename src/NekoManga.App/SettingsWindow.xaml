                        <DockPanel Margin="0,4,0,12">
                            <Image Source="{DynamicResource NekoLogo}" Width="46" Height="46" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                            <ui:Button Content="GitHub 열기" Click="BtnGitHub_Click" Padding="14,6" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NekoManga" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource NekoText}"/>
                                <TextBlock x:Name="TxtAboutVersion" Style="{StaticResource HintText}"/>
                                <TextBlock Style="{StaticResource HintText}" Text="흑백 만화 자동 채색 + 검열 제거 + 번역 식자 올인원이다냥."/>
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Columns="2" Rows="1">
                            <!-- 화면 언어 — 칸의 이름(한국어 / English / 日本語)은 코드가 채운다(UiText.FillLanguagePicker). 만화를 옮기는 언어(번역 탭)와는 따로다 -->
                            <Border Style="{StaticResource SideCard}" Margin="0,0,5,10">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="🌐 화면 언어"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <ComboBox x:Name="CmbUiLanguage" MinWidth="180" HorizontalAlignment="Left" SelectionChanged="UiLanguage_Changed"/>
                                        <TextBlock Style="{StaticResource SetHint}" Text="고르는 즉시 열린 창의 글이 바뀐다냥. 이미 나와 있는 진행 글은 다음에 바뀔 때 새 언어로 나온다냥. 만화를 옮기는 언어(번역 탭)와는 따로다냥."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SideCard}" Margin="5,0,0,10">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="화면 테마"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <RadioButton x:Name="RbThemeLight" Content="☀ 화이트 (원고지)" IsChecked="True"
                                                         Foreground="{DynamicResource NekoText}" Margin="0,0,18,0"
                                                         Checked="Theme_Changed"/>
                                            <RadioButton x:Name="RbThemeDark" Content="🌙 다크 (먹지)"
                                                         Foreground="{DynamicResource NekoText}"
                                                         Checked="Theme_Changed"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SetHint}" Text="고르는 즉시 모든 창에 적용된다냥."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="내장 AI 모듈"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="• 텍스트 감지 — comictextdetector: 말풍선과 글자 위치를 찾는다냥."/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" Text="• 글자 인식 — manga-ocr: 일본어 세로쓰기 특화 OCR이다냥."/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" Text="• 검열 감지 — Aletheia Lens(Mask R-CNN): 막대·모자이크를 찾는다냥.&#10;· 전용 모델(YOLO-seg)이 흰 막대선을 보완한다냥."/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" Text="• 기본 검열 제거 — Aletheia Lens(DeepCreamPy): 찾은 자리를 주변에 맞춰 채운다냥.&#10;· '재생성'은 SDXL, '커스텀'은 내 워크플로다냥."/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" Text="• 글자 지움 — LaMa(만화·애니 학습판): 지운 글자 자리를 메운다냥."/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" Text="• 번역 — Google(무료) / DeepL / DeepSeek / Grok 중 고른다냥."/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" Text="• 자동 채색 — SDXL + ControlNet 2단: 원고 선을 따라 컬러로 그린다냥.&#10;· WD14 태거가 프롬프트를 만든다냥."/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,4" Text="• 식자 — 내장 렌더러: 번역문을 말풍선에 외곽선과 함께 그린다냥."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="프로그램 삭제"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <TextBlock Style="{StaticResource HintText}" Text="앱과 바로가기를 지운다냥.&#10;· 구성요소 폴더는 커서 자동으로 안 지운다냥 — 직접 지워 줘냥."/>
                                    <ui:Button x:Name="BtnUninstall" Content="🗑 NekoManga 삭제하기" Click="BtnUninstall_Click"
                                               Appearance="Danger" Margin="0,8,0,4" Padding="16,8" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
