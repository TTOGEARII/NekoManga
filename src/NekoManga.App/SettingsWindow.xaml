                                                     ToolTip="띄어쓰기 폭이다냥. 1이면 글꼴 그대로, 작을수록 붙는다냥."/>
                                            <TextBlock Text="0.3 ~ 2" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <CheckBox x:Name="ChkLetterItalic" Content="기울임" Foreground="{DynamicResource NekoText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource SetHint}"
                                               Text="크기 배율 1.0 = 말풍선에 맞춘 크기다냥.&#10;· 줄간격·어절 간격 1.0 = 기본. 글자 색은 #RRGGBB(기본 검정), auto면 원문 색이다냥.&#10;· 외곽선 0 = 없음."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── 엔진 (ComfyUI 수명·모델 관리 — 초보자용) ── -->
            <TabItem Header="⚙ 엔진" Style="{StaticResource SideNavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,4">
                    <StackPanel>
                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="채색 엔진"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <DockPanel>
                                        <Ellipse x:Name="DotEngine" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center"/>
