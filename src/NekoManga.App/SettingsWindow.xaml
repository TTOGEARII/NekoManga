                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="선화 강도" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtAdvCnLineStr" Width="70" HorizontalAlignment="Left"/>
                                            <TextBlock Text="0 ~ 2" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="선화 구간 끝" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtAdvCnLineEnd" Width="70" HorizontalAlignment="Left"/>
                                            <TextBlock Text="0 ~ 1" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="스케치 강도" Style="{StaticResource SetLabel}"/>
                                            <TextBox DockPanel.Dock="Left" x:Name="TxtAdvCnScrStr" Width="70" HorizontalAlignment="Left"/>
                                            <TextBlock Text="0 ~ 2" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="스케치 구간 시작" Style="{StaticResource SetLabel}"/>
