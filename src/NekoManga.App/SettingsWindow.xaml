                                    <!-- 2026-11-15 자리별 태그: 그리는 방식이 바뀐다 — 사용자가 전/후를 보고 정하기 전까지 기본 끔 -->
                                    <CheckBox x:Name="ChkRegenTagsPerPiece" Content="남녀 부위가 같이 있으면 자리마다 그 성별의 태그만 넣는다냥 (시험 중)" Foreground="{DynamicResource NekoText}" Margin="0,6,0,0"
