                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── ③ 확인하고 고치기 ── -->
                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="③ 지우기 전에 확인하기"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <CheckBox x:Name="ChkReview" Content="지우기 전에 마스크를 직접 확인·추가한다냥" Foreground="{DynamicResource NekoText}"/>
                                    <DockPanel Style="{StaticResource SetRow}" Margin="0,6,0,0">
                                        <TextBlock Text="검토 방식" Style="{StaticResource SetLabel}"/>
                                        <ComboBox x:Name="CmbReviewMode"
                                                  ToolTip="페이지별: 검열 없는 장은 바로 끝난다냥.&#10;· 감지된 장은 목록에서 더블클릭해 고친 뒤 [검열 제거 시작]을 누르라냥.">
                                            <ComboBoxItem Tag="PerPage" Content="페이지별 — 감지된 장만 검토 대기, 나머지는 바로 진행한다냥" IsSelected="True"/>
