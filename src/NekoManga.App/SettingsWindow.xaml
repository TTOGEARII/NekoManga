                                        <ui:Button Content="찾기…" Click="BtnColorCustomPick_Click" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0"/>
                                        <TextBox x:Name="TxtColorCustom" ToolTip="비우면 내장 채색 워크플로를 쓴다냥"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SetHint}" Text="ComfyUI에서 워크플로를 만들고 Export (API)로 저장하면 커스텀으로 끼울 수 있다냥.&#10;· 지정하면 이 워크플로로 채색한다냥 (LoadImage 1개 = 원고, SaveImage 1개 = 결과)."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SideCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SideCardHead}"><TextBlock Style="{StaticResource SideTitle}" Text="채색 모델"/></Border>
                                <StackPanel Style="{StaticResource SideBody}">
                                    <DockPanel Style="{StaticResource SetRow}">
                                        <TextBlock Text="그림 모델" Style="{StaticResource SetLabel}"/>
