                                            <TextBlock Text="512 ~ 2048" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Rows="2">
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="조각 인페인트 확장" Style="{StaticResource SetLabel}"/>
