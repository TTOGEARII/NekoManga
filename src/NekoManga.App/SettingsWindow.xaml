                                            <TextBlock Text="0 ~ 4" Style="{StaticResource SetRange}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SetRow}">
                                            <TextBlock Text="외곽선 색" Style="{StaticResource SetLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="SwLetterOutlineColor" Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource NekoStroke}" BorderThickness="1"
