<ui:FluentWindow x:Class="NekoManga.App.ResultWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:NekoManga.App"
                 Title="결과 보기 — 놓친 검열을 직접 지운다냥"
                 Width="1280" Height="940" MinWidth="980" MinHeight="620"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource NekoBg}" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" KeyDown="Window_KeyDown"
                 PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <!-- 배치(2026-11-19 사용자 "기능들 배치 가독성"): 도구는 오른쪽 세로 패널에 묶음별로, 원고는 왼쪽에 크게. 위 줄은 장 이동·확대만.
         Grid 별 행 대신 DockPanel을 쓴다 — 창이 작아져도 아래 버튼 바가 먼저 자리를 잡아 잘려 사라지지 않는다 (Grid * 행에서는 실제로 잘렸다).
         컨트롤의 x:Name과 이벤트는 그대로다 — 코드 비하인드는 이름으로만 찾는다. -->
    <ui:FluentWindow.Resources>
        <local:SubtractConverter x:Key="Subtract"/>   <!-- 콤보 항목 MaxWidth = 콤보 폭 − 32 (CmbBlocks) -->
        <!-- 패널의 묶음 = 카드(2026-11-20 사용자 "영역을 좀더 가독성 있게 구분"): 먹선 테두리 + 먹색 제목 띠(재생성 칸의 꼬리표와 같은 결). 제목만 있던 때는 묶음의 경계가 안 보였다.
             카드 = SideCard > StackPanel > (SideCardHead > SideTitle) + SideBody -->
        <Style x:Key="SideCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource NekoStroke}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource NekoCard}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SideCardHead" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NekoStroke}"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
        <Style x:Key="SideTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NekoBg}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="SideBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="10,8,10,4"/>
        </Style>
        <!-- 접이식 카드의 제목 띠(안내 카드, 2026-11-20): 띠 전체가 단추, 오른쪽 끝에 ▸/▾. Focusable=False — Space는 손 도구다(단추에 포커스가 가면 Space가 단추를 누른다) -->
        <Style x:Key="SideCardToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{DynamicResource NekoStroke}" Padding="10,3">
                            <DockPanel>
                                <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="▸" Foreground="{DynamicResource NekoBg}" FontWeight="Bold" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="▾"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 단축키 표(사용자 "B : 브러시, E : 지우개 꼴로"): 왼쪽 키캡(바닥색 + 옅은 테두리 — 어두운 테마에서 바닥색만으로는 안 보인다) + 오른쪽 설명 -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NekoCanvas}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NekoHint}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="0,2,10,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 칸 이름 (왼쪽 최소 폭 — 고정 폭이면 영어 "Outline color"가 잘린다, 검수 2026-11-19) -->
        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SideRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="SideCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource NekoText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="SideRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="결과 보기" ShowMaximize="True"/>

        <!-- 위 줄: 장 이동 · 파일 이름 · 확대 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource NekoCard}" BorderBrush="{DynamicResource NekoStroke}" BorderThickness="2" CornerRadius="0" Margin="16,8,16,8" Padding="14,8">
            <DockPanel>
                <ui:Button x:Name="BtnPrev" DockPanel.Dock="Left" Content="◀ 이전" Click="BtnPrev_Click" Padding="12,4"/>
                <ui:Button x:Name="BtnNext" DockPanel.Dock="Left" Content="다음 ▶" Click="BtnNext_Click" Padding="12,4" Margin="6,0,12,0"/>
                <TextBlock x:Name="TxtCount" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource NekoPink}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <ComboBox x:Name="CmbPages" DockPanel.Dock="Left" SelectionChanged="CmbPages_Changed" MaxWidth="300" VerticalAlignment="Center"/>
                <!-- 고친 장 모두 다시 렌더링 (2026-11-13 사용자 요청) — 여러 장에 걸친 일이라 장 줄에 둔다. 메인 창이 연 창에서만 보인다(묶음은 메인 창이 돌린다) -->
                <ui:Button x:Name="BtnRerenderEdited" DockPanel.Dock="Right" Content="🔁 고친 장 모두 다시 렌더링" Click="BtnRerenderEdited_Click"
                           Appearance="Caution" Padding="14,4" Margin="12,0,0,0" Visibility="Collapsed" IsEnabled="False"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="확대" Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="SldZoom" Minimum="0.2" Maximum="4" Value="1" Width="150"
                            VerticalAlignment="Center" ValueChanged="Zoom_Changed"/>
                    <TextBlock x:Name="TxtZoom" Text="100%" Foreground="{DynamicResource NekoText}"
                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"/>
                </StackPanel>
                <TextBlock x:Name="TxtFile" Foreground="{DynamicResource NekoHint}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 아래 줄: 상태 · 되돌리기 · 지우기/다시 식자 · 저장 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource NekoCard}" BorderBrush="{DynamicResource NekoStroke}" BorderThickness="2" CornerRadius="0" Margin="16,8,16,12" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="BtnUndo" Content="↩ 되돌리기" Click="BtnUndo_Click" Padding="14,6" Margin="8,0,0,0" IsEnabled="False"/>
                    <ui:Button x:Name="BtnRedo" Content="↪ 다시 실행" Click="BtnRedo_Click" Padding="14,6" Margin="8,0,0,0" IsEnabled="False" Visibility="Collapsed"
                               ToolTip="되돌린 편집을 다시 한다냥 (Ctrl+Y)"/>
                    <ui:Button x:Name="BtnApply" Content="✨ 선택 영역 지우기" Click="BtnApply_Click"
                               Appearance="Primary" Padding="16,6" Margin="8,0,0,0"/>
                    <ui:Button x:Name="BtnSave" Content="💾 저장" Click="BtnSave_Click" Padding="14,6" Margin="8,0,0,0" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Foreground="{DynamicResource NekoText}" Text="준비됐다냥"/>
            </DockPanel>
        </Border>

        <!-- 오른쪽 도구 패널: 탭(검열 지우기 / 식자)마다 묶음을 세로로 -->
        <Border DockPanel.Dock="Right" Width="350" Background="{DynamicResource NekoCard}" BorderBrush="{DynamicResource NekoStroke}" BorderThickness="2" CornerRadius="0" Margin="0,0,16,0">
            <TabControl x:Name="TabMode" Background="Transparent" BorderThickness="0" Margin="8,6,8,8"
                        SelectionChanged="TabMode_Changed">
                <!-- 검열 지우기 = 마스크 편집 한 방식 (2026-11-11, 사용자 요청으로 '마스크 수정' 탭과 합침).
                     마스크 보기: 검열 제거 전 원고(.pre.png) 위 빨간 마스크를 칠한다(저장 마스크가 없는 장은 결과물 위 빈 마스크).
                     [지우기]는 이 장만 검열 제거·식자를 다시 한다 — 채색은 돌리지 않는다(사용자 결정). 끝나면 결과 보기로 바뀐다.
                     묶음마다 카드(먹선 테두리 + 먹색 제목 띠, SideCard/SideCardHead/SideBody)로 나눈다 — 2026-11-20 사용자 "영역을 좀더 가독성 있게 구분". 제목만 있던 때는 묶음의 경계가 안 보였다. -->
                <TabItem x:Name="TabDecensor" Header="🙈 검열 지우기">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="4,6,8,4">
                            <!-- 안내: 접이식(2026-11-20 사용자 "접었다 펼 수 있는 기능으로") — 제목 띠가 단추(SideCardToggle), 펼침은 설정 ResultGuideOpen에 남고 두 탭이 같이 움직인다(코드 ShowGuide).
                                 첫 줄은 늘 보이고 단축키 표(키캡 | 설명 — 사용자 "B : 브러시, E : 지우개 꼴로")만 접힌다. 다시 렌더링 안내는 코드가 TxtDecensorHint에 줄을 덧붙인다 -->
                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <ToggleButton x:Name="TglGuideMask" Style="{StaticResource SideCardToggle}" Checked="Guide_Toggled" Unchecked="Guide_Toggled">
                                        <TextBlock Text="안내" Style="{StaticResource SideTitle}"/>
                                    </ToggleButton>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <TextBlock x:Name="TxtDecensorHint" Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                   Text="빨간 곳이 지워진다냥."/>
                                        <Grid x:Name="PnlGuideMask" Visibility="Collapsed" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource KeyCap}"><TextBlock Text="B" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="브러시로 칠하기" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="1" Style="{StaticResource KeyCap}"><TextBlock Text="E" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="지우개" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="2" Style="{StaticResource KeyCap}"><TextBlock Text="L" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="다각형 (Enter 닫기 · Esc 취소)" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="3" Style="{StaticResource KeyCap}"><TextBlock Text="[ ]" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="브러시 크기" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="4" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl+Z" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="되돌리기" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="5" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl+D" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="마스크 전부 지우기" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="6" Style="{StaticResource KeyCap}"><TextBlock Text="Space" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="누른 채 끌면 화면 이동" Style="{StaticResource KeyDesc}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Text="보기" Style="{StaticResource SideTitle}"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}" Orientation="Horizontal" Margin="10,8,10,8">
                                        <RadioButton x:Name="RbViewMask" Content="🎭 마스크 보기" IsChecked="True" GroupName="View" Style="{StaticResource SideRadio}" Checked="View_Changed"
                                                     ToolTip="검열 제거 전 원고에 지울 곳(빨강)을 칠한다냥"/>
                                        <RadioButton x:Name="RbViewResult" Content="👁 결과 보기" GroupName="View" Style="{StaticResource SideRadio}" Checked="View_Changed"
                                                     ToolTip="지금 결과물을 본다냥 (칠하기는 마스크 보기에서)"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Text="도구" Style="{StaticResource SideTitle}"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <RadioButton x:Name="RbMAdd" Content="🖌 칠하기" IsChecked="True" GroupName="MaskTool" ToolTip="B" Style="{StaticResource SideRadio}" Checked="MaskTool_Changed"/>
                                            <RadioButton x:Name="RbMErase" Content="🧽 지우개" GroupName="MaskTool" ToolTip="E" Style="{StaticResource SideRadio}" Checked="MaskTool_Changed"/>
                                            <RadioButton x:Name="RbMPoly" Content="⬠ 다각형" GroupName="MaskTool" ToolTip="L — 꼭짓점을 찍고 더블클릭/Enter로 닫는다냥" Style="{StaticResource SideRadio}" Checked="MaskTool_Changed"/>
                                        </StackPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="브러시" Style="{StaticResource SideLabel}"/>
                                            <TextBlock x:Name="TxtMBrush" DockPanel.Dock="Right" Text="24px" Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="44"/>
                                            <Slider x:Name="SldMBrush" Minimum="4" Maximum="120" Value="24" VerticalAlignment="Center" ToolTip="브러시 반지름(원본 px) — [ ] 키로도 바꾼다냥"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="다각형" Style="{StaticResource SideLabel}" ToolTip="다각형을 닫을 때 안쪽의 그 톤만 마스크에 더한다냥 (브러시는 늘 전체)"/>
                                            <WrapPanel>
                                                <RadioButton x:Name="RbDarkOnly" Content="검은 부분만" IsChecked="True" GroupName="Tone" Style="{StaticResource SideRadio}"/>
                                                <RadioButton x:Name="RbWhiteOnly" Content="흰 부분만" GroupName="Tone" Style="{StaticResource SideRadio}"/>
                                                <RadioButton x:Name="RbWholeRect" Content="도형 전체" GroupName="Tone" Style="{StaticResource SideRadio}"/>
                                            </WrapPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Text="지우기" Style="{StaticResource SideTitle}"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="모델" Style="{StaticResource SideLabel}"/>
                                            <ComboBox x:Name="CmbEngine" VerticalAlignment="Center" SelectionChanged="CmbEngine_Changed">
                                                <ComboBoxItem x:Name="ItemEngineBasic" Tag="Basic" Content="기본 — Aletheia 복원 (빠름)" IsSelected="True" ToolTip="내장 복원 모델 — 주변 그림에 맞춰 채운다냥 (항상 같은 결과)"/>
                                                <ComboBoxItem Tag="ComfyRegen" Content="재생성 (SDXL·GPU)" ToolTip="내장 재생성 레시피로 다시 그린다냥"/>
                                                <ComboBoxItem Tag="ComfyCustom" Content="커스텀 ComfyUI" ToolTip="설정 → 검열 제거의 커스텀 워크플로 파일"/>
                                            </ComboBox>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="여유(px)" Style="{StaticResource SideLabel}"/>
                                            <TextBox x:Name="TxtGrow" Text="0" Width="64" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     ToolTip="지울 때 마스크를 이만큼 넓힌다냥 — 0이면 저장 마스크 그대로"/>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Text="마스크" Style="{StaticResource SideTitle}"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <WrapPanel>
                                            <ui:Button Content="자동 감지로" Click="BtnMReset_Click" Padding="10,4" Margin="0,0,8,6" ToolTip="이 장의 마스크를 자동 감지 결과로 되돌린다냥"/>
                                            <ui:Button Content="전부 지우기" Click="BtnMClear_Click" Padding="10,4" Margin="0,0,8,6" ToolTip="Ctrl+D"/>
                                            <CheckBox x:Name="ChkMSkip" Content="이 페이지는 검열 없음" Style="{StaticResource SideCheck}" Margin="0,0,0,6"
                                                      Checked="ChkMSkip_Changed" Unchecked="ChkMSkip_Changed"
                                                      ToolTip="마스크가 있어도 검열 제거를 건너뛴다냥"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtMaskInfo" Foreground="{DynamicResource NekoPink}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 조각의 성별(2026-11-15, 모델 = 재생성일 때만): 그림 위의 남/여 표시를 한꺼번에 바꾼다. 표시 하나만 바꾸려면 그 표시를 누른다 -->
                            <Border x:Name="PnlSexAll" Style="{StaticResource SideCard}" Visibility="Collapsed">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}">
                                        <TextBlock Text="부위 성별" Style="{StaticResource SideTitle}"
                                                   ToolTip="조각마다 남·여 태그를 가려 넣는다냥. 그림 위의 표시를 누르면 바뀐다냥(남성 → 여성 → 남녀 → 자동). 고른 것은 마스크와 함께 저장된다냥. ?는 모르는 조각이니 골라 줘냥"/>
                                    </Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <WrapPanel>
                                            <ui:Button Content="모두 남성" Tag="Male" Click="BtnSexAll_Click" Padding="8,4" Margin="0,0,6,6" ToolTip="이 장의 모든 조각을 남성으로 고른다냥"/>
                                            <ui:Button Content="모두 여성" Tag="Female" Click="BtnSexAll_Click" Padding="8,4" Margin="0,0,6,6" ToolTip="이 장의 모든 조각을 여성으로 고른다냥"/>
                                            <ui:Button Content="자동으로" Tag="Auto" Click="BtnSexAll_Click" Padding="8,4" Margin="0,0,6,6" ToolTip="직접 고른 것을 전부 지우고 자동 판단으로 되돌린다냥"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 재생성(SDXL)일 때만: 이 장에만 쓰는 프롬프트·수치 (설정에는 저장 안 함, 장마다 따로 기억). 접이식 — 기본은 접힘, 머리글에 '이 장 값 사용 중' 표시 -->
                            <Border x:Name="PnlRegen" Style="{StaticResource SideCard}" Visibility="Collapsed">
                                <Expander x:Name="ExpRegen" IsExpanded="False" Padding="8,4,8,8">
                                    <Expander.Header>
                                        <StackPanel>
                                            <Border Style="{StaticResource MangaTag}" HorizontalAlignment="Left" Margin="0,4,0,4"><TextBlock Style="{StaticResource MangaTagText}" Text="재생성 설정 — 이 페이지만"/></Border>
                                            <TextBlock x:Name="TxtRegenHdr" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,0" Text="⚙ 설정값 그대로"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="여기 값은 이 장의 재생성에만 쓴다냥 (⚙ 설정에는 저장 안 함).&#10;· 창을 닫으면 사라진다냥."/>
                                        <TextBlock Text="프롬프트" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtRgPrompt" TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="5" VerticalScrollBarVisibility="Auto" Margin="0,2,0,6"
                                                 ToolTip="SDXL에 주는 기본 프롬프트 — 원고 풍·선화 유지 같은 전체 지시다냥"/>
                                        <TextBlock Text="태그 — 남성" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtRgBodyM" Margin="0,2,0,6" ToolTip="남성 부위 태그 — 확실한 영역에는 이것만, 아니면 여성 태그와 같이 넣는다냥. 빼려면 비워 두라냥"/>
                                        <TextBlock Text="태그 — 여성" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtRgBodyF" Margin="0,2,0,6" ToolTip="여성 부위 태그 — 확실한 영역에는 이것만, 아니면 남성 태그와 같이 넣는다냥. 남성 부위에 여성 부위가 그려지면 비우고 [지우기]하라냥"/>
                                        <TextBlock Text="부정 프롬프트" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtRgNeg" Margin="0,2,0,6" TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="5" VerticalScrollBarVisibility="Auto"
                                                 ToolTip="그리지 말 것 — 검열 흔적·글자·효과음 등이다냥"/>
                                        <!-- 세로 패널(350px)에는 2열(라벨 100 + 칸 56~90 = 164~198px × 2)이 들어가지 않는다 — 1열, 라벨 170(영어 "Line art strength (0 ~ 2)"도 한 줄 — 150에서는 두 줄로 접혔다) (검수 2026-11-19) -->
                                        <UniformGrid Columns="1" Margin="0,2,0,0">
                                            <DockPanel Margin="0,0,0,6"><TextBlock Text="Denoise (0.05 ~ 1)" Style="{StaticResource FieldLabel}" Width="170"/><TextBox x:Name="TxtRgDenoise" Width="56" HorizontalAlignment="Left" ToolTip="높을수록 많이 다시 그린다냥. 기본 0.62"/></DockPanel>
                                            <DockPanel Margin="0,0,0,6"><TextBlock Text="스텝 (1 ~ 150)" Style="{StaticResource FieldLabel}" Width="170"/><TextBox x:Name="TxtRgSteps" Width="56" HorizontalAlignment="Left"/></DockPanel>
                                            <DockPanel Margin="0,0,0,6"><TextBlock Text="CFG (0 ~ 30)" Style="{StaticResource FieldLabel}" Width="170"/><TextBox x:Name="TxtRgCfg" Width="56" HorizontalAlignment="Left"/></DockPanel>
                                            <DockPanel Margin="0,0,0,6"><TextBlock Text="시드 (-1 = 랜덤)" Style="{StaticResource FieldLabel}" Width="170"/><TextBox x:Name="TxtRgSeed" Width="90" HorizontalAlignment="Left" ToolTip="같은 시드면 같은 결과다냥 — 마음에 든 결과를 다시 내려면 고정하라냥"/></DockPanel>
                                            <DockPanel Margin="0,0,0,6"><TextBlock Text="선화 강도 (0 ~ 2)" Style="{StaticResource FieldLabel}" Width="170"/><TextBox x:Name="TxtRgCnStr" Width="56" HorizontalAlignment="Left" ToolTip="원고 선을 얼마나 따를지다냥 (ControlNet)"/></DockPanel>
                                            <DockPanel Margin="0,0,0,6"><TextBlock Text="선화 구간 끝 (0 ~ 1)" Style="{StaticResource FieldLabel}" Width="170"/><TextBox x:Name="TxtRgCnEnd" Width="56" HorizontalAlignment="Left" ToolTip="샘플링의 몇 %까지 선화를 따를지다냥"/></DockPanel>
                                        </UniformGrid>
                                        <!-- 시드 기록·고정(2026-11-15): 위 칸들과 달리 그 장의 .neko 사이드카에 남는다 — 창을 닫아도, 묶음·[시작]으로 돌려도 그 시드 -->
                                        <CheckBox x:Name="ChkRgSeedLock" Content="이 장의 시드 고정" Style="{StaticResource SideCheck}" Margin="0,4,0,0" IsEnabled="False" Click="ChkRgSeedLock_Click"
                                                  ToolTip="지난 재생성의 시드를 이 장에 고정한다냥 — 다음에도 이 시드로 그린다냥. 창을 닫아도 남는다냥"/>
                                        <TextBlock x:Name="TxtRgLastSeed" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0" Text="아직 적힌 시드가 없다냥"/>
                                        <ui:Button Content="↺ 이 페이지 값을 설정값으로 되돌리기" Click="BtnRegenReset_Click" Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                   ToolTip="이 장의 값을 ⚙ 설정의 재생성 값으로 되돌린다냥"/>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabLetter" Header="💬 식자 다시 하기">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="4,6,8,4">
                            <!-- 안내: 접이식(검열 지우기 탭과 같은 상태) — 한 줄은 늘 보이고 조작 표(마우스·키 | 설명)만 접힌다 -->
                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <ToggleButton x:Name="TglGuideLetter" Style="{StaticResource SideCardToggle}" Checked="Guide_Toggled" Unchecked="Guide_Toggled">
                                        <TextBlock Text="안내" Style="{StaticResource SideTitle}"/>
                                    </ToggleButton>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <TextBlock x:Name="TxtLetterHint" Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                   Text="풍선을 골라 고치고, 다 고치면 [다시 식자]를 누르라냥."/>
                                        <Grid x:Name="PnlGuideLetter" Visibility="Collapsed" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource KeyCap}"><TextBlock Text="클릭" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="풍선 고르기" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="1" Style="{StaticResource KeyCap}"><TextBlock Text="끌기" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="옮기기 (손잡이는 크기·돌리기)" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="2" Style="{StaticResource KeyCap}"><TextBlock Text="두 번 클릭" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="글 고치기 (Ctrl+Enter 끝 · Esc 취소)" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="3" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl+Z" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="되돌리기" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="4" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl+Y" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="다시 실행" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="5" Style="{StaticResource KeyCap}"><TextBlock Text="Delete" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="고른 풍선 숨기기" Style="{StaticResource KeyDesc}"/>
                                            <Border Grid.Row="6" Style="{StaticResource KeyCap}"><TextBlock Text="올리기" Style="{StaticResource KeyCapText}"/></Border>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="풍선의 원문 보기 (툴팁)" Style="{StaticResource KeyDesc}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 선택한 풍선의 글자 속성 (포토샵의 문자 패널처럼: 풍선을 고르고 값을 바꾸면 그 풍선에만, 그림에 바로 보인다). 크기·외곽선의 px는 결과 그림의 픽셀이다. -->
                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Text="선택한 풍선" Style="{StaticResource SideTitle}"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <!-- 항목(고른 것도)은 폭에서 잘리면 "…"을 붙인다(한 줄) — 글자 중간에서 "1. 그런 이유로 오늘은 아침부터 계ㅅ"처럼 끊기던 것(2026-11-26 사용자 "잘리면 그 뒤에는 …으로").
                                             항목의 MaxWidth = 콤보 폭 − 32(항목 안쪽 여백, SubtractConverter): 펼친 목록(Popup)은 자식을 폭 제한 없이 재서, 상한이 없으면 가장 긴 항목만큼 화면 폭까지 넓어진다(전에는 22자 컷이 막았다 — 검수 지적). 콤보 폭 그대로면 목록이 32px 더 넓었다(하네스 310 vs 278).
                                             온 글은 툴팁에 — 닫힌 콤보의 고른 항목은 클릭을 안 받아(템플릿의 PART_ContentPresenter) 콤보 자체에 SelectedItem 툴팁, 펼친 목록은 항목 툴팁 -->
                                        <ComboBox x:Name="CmbBlocks" SelectionChanged="CmbBlocks_Changed" Margin="0,0,0,6"
                                                  ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                                               MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}, Converter={StaticResource Subtract}, ConverterParameter=32}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <!-- 원문(OCR 글, 2026-11-26 사용자 요청): 번역 글을 고칠 때 원문을 보며 고치게. 읽기 전용이지만 골라 복사할 수 있다 — 원문이 없는 글([새 글 넣기])은 ShowBlockSource가 접는다 -->
                                        <DockPanel x:Name="PnlBlockSource" Style="{StaticResource SideRow}" Visibility="Collapsed">
                                            <TextBlock Text="원문" Style="{StaticResource SideLabel}" DockPanel.Dock="Top" MinWidth="0" Margin="0,0,0,2"/>
                                            <!-- 최소 높이는 전의 크기(72px, 3줄)로 두고 상한만 없앤다: 긴 원문은 칸이 내용만큼 늘어난다(패널이 스크롤) — 3줄 + 스크롤이던 것을 2026-11-26 사용자 요청으로 -->
                                            <TextBox x:Name="TxtBlockSource" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72"
                                                     Foreground="{DynamicResource NekoHint}" ToolTip="번역 전 원문이다냥 — 골라서 복사할 수 있다냥"
                                                     Language="ja-JP"/>   <!-- 원문은 대개 일본어 — 한국어 화면에서도 한자를 일본 글꼴 자형으로 (창의 xml:lang은 일본어 화면에서만 건다, i18n.md) -->
                                        </DockPanel>
                                        <!-- 여러 줄: Enter로 줄을 나눈다(풍선을 두 번 클릭해 그 자리에서 고치는 것과 같은 글). 높이 상한 없음 — 긴 글은 칸이 늘어난다(원문 칸과 같게, 2026-11-26) -->
                                        <TextBox x:Name="TxtBlockText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                                 TextChanged="TxtBlockText_Changed" Margin="0,0,0,6"/>
                                        <WrapPanel>
                                            <ui:Button x:Name="BtnBlockAdd" Content="＋ 새 글 넣기" Click="BtnBlockAdd_Click" Padding="10,4" Margin="0,0,6,6"
                                                       ToolTip="누른 뒤 글을 넣을 곳을 클릭하라냥 (Esc로 취소)"/>
                                            <ui:Button x:Name="BtnBlockHide" Content="이 블록 숨기기" Click="BtnBlockHide_Click" Padding="10,4" Margin="0,0,6,6"/>
                                            <ui:Button x:Name="BtnBlockReset" Content="속성 초기화" Click="BtnBlockReset_Click" Padding="10,4" Margin="0,0,6,6"
                                                       ToolTip="이 풍선의 속성을 자동·페이지 설정으로 되돌린다냥 (글과 자리는 그대로)"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Text="글자" Style="{StaticResource SideTitle}"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="글꼴" Style="{StaticResource SideLabel}"/>
                                            <ComboBox x:Name="CmbBFont" VerticalAlignment="Center" SelectionChanged="BlockStyle_Changed"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="크기" Style="{StaticResource SideLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="TxtBSize" Width="64" VerticalAlignment="Center" Tag="1"
                                                         TextChanged="BlockStyle_Changed" PreviewKeyDown="NumBox_PreviewKeyDown" PreviewMouseWheel="NumBox_MouseWheel"
                                                         ToolTip="글자 크기(px)다냥. ↑↓ 키나 휠로 1씩(Shift는 10씩)"/>
                                                <TextBlock Text="px" Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                <CheckBox x:Name="ChkBSizeAuto" Content="자동" Style="{StaticResource SideCheck}" Margin="12,0,0,0"
                                                          Checked="BlockStyle_Changed" Unchecked="BlockStyle_Changed"
                                                          ToolTip="켜면 풍선에 맞춰 크기를 정한다냥. 숫자를 적으면 꺼진다냥"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="굵기" Style="{StaticResource SideLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ComboBox x:Name="CmbBBold" Width="132" VerticalAlignment="Center" SelectionChanged="BlockStyle_Changed">
                                                    <ComboBoxItem Tag="-1" Content="페이지 설정" IsSelected="True"/>
                                                    <ComboBoxItem Tag="1" Content="굵게"/>
                                                    <ComboBoxItem Tag="0" Content="보통"/>
                                                </ComboBox>
                                                <CheckBox x:Name="ChkBItalic" Content="기울임" Style="{StaticResource SideCheck}" Margin="12,0,0,0"
                                                          Checked="BlockStyle_Changed" Unchecked="BlockStyle_Changed"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Text="배치" Style="{StaticResource SideTitle}"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="정렬" Style="{StaticResource SideLabel}"/>
                                            <ComboBox x:Name="CmbBAlign" Width="132" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="BlockStyle_Changed">
                                                <ComboBoxItem Tag="" Content="페이지 설정" IsSelected="True"/>
                                                <ComboBoxItem Tag="Left" Content="왼쪽"/>
                                                <ComboBoxItem Tag="Center" Content="가운데"/>
                                                <ComboBoxItem Tag="Right" Content="오른쪽"/>
                                            </ComboBox>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="줄간격" Style="{StaticResource SideLabel}"/>
                                            <!-- WrapPanel: 영어("Manual line break")는 한 줄에 안 들어가 체크박스가 잘렸다(캡처 확인 2026-11-19) — 좁으면 다음 줄로 -->
                                            <WrapPanel Orientation="Horizontal">
                                                <TextBox x:Name="TxtBLineSp" Width="56" VerticalAlignment="Center" Tag="0.05"
                                                         TextChanged="BlockStyle_Changed" PreviewKeyDown="NumBox_PreviewKeyDown" PreviewMouseWheel="NumBox_MouseWheel"
                                                         ToolTip="줄 간격 배율(1 = 기본) — 비우면 페이지 설정이다냥"/>
                                                <TextBlock Text="×" Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                <CheckBox x:Name="ChkBManualLines" Content="줄 직접 나누기" Style="{StaticResource SideCheck}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                          Checked="ChkBManualLines_Changed" Unchecked="ChkBManualLines_Changed"
                                                          ToolTip="켜면 Enter로 나눈 줄 그대로 그린다냥. 끄면 자동으로 나눈다냥"/>
                                            </WrapPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="회전" Style="{StaticResource SideLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="TxtBRot" Width="56" VerticalAlignment="Center" Tag="1"
                                                         TextChanged="BlockStyle_Changed" PreviewKeyDown="NumBox_PreviewKeyDown" PreviewMouseWheel="NumBox_MouseWheel"
                                                         ToolTip="돌리는 각도(-180~180°) — 위 동그란 손잡이를 끌어도 된다냥"/>
                                                <TextBlock Text="°" Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Text="색 · 외곽선" Style="{StaticResource SideTitle}"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="글자 색" Style="{StaticResource SideLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="SwBColor" Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource NekoStroke}" BorderThickness="1"
                                                        Cursor="Hand" VerticalAlignment="Center" Margin="0,0,6,0" MouseLeftButtonUp="Swatch_Click"
                                                        Tag="{Binding ElementName=TxtBColor}" ToolTip="색 고르기"/>
                                                <TextBox x:Name="TxtBColor" Width="92" VerticalAlignment="Center" TextChanged="BlockStyle_Changed"
                                                         ToolTip="#RRGGBB — 비우면 페이지 설정이다냥"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="외곽선" Style="{StaticResource SideLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="TxtBOut" Width="56" VerticalAlignment="Center" Tag="0.5"
                                                         TextChanged="BlockStyle_Changed" PreviewKeyDown="NumBox_PreviewKeyDown" PreviewMouseWheel="NumBox_MouseWheel"
                                                         ToolTip="외곽선 두께(px)다냥. 0이면 없음. ↑↓ 키나 휠로 0.5씩(Shift는 5씩)"/>
                                                <TextBlock Text="px" Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                <CheckBox x:Name="ChkBOutAuto" Content="자동" Style="{StaticResource SideCheck}" Margin="12,0,0,0"
                                                          Checked="BlockStyle_Changed" Unchecked="BlockStyle_Changed"
                                                          ToolTip="켜면 페이지 기본 외곽선을 따른다냥. 숫자를 적으면 꺼진다냥"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="외곽선 색" Style="{StaticResource SideLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="SwBOutColor" Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource NekoStroke}" BorderThickness="1"
                                                        Cursor="Hand" VerticalAlignment="Center" Margin="0,0,6,0" MouseLeftButtonUp="Swatch_Click"
                                                        Tag="{Binding ElementName=TxtBOutColor}" ToolTip="색 고르기"/>
                                                <TextBox x:Name="TxtBOutColor" Width="92" VerticalAlignment="Center" TextChanged="BlockStyle_Changed"
                                                         ToolTip="#RRGGBB — 비우면 페이지 설정이다냥"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 이 장의 모든 풍선에 쓰는 기본값 — 풍선에 따로 정한 값이 이긴다 -->
                            <Border Style="{StaticResource SideCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SideCardHead}"><TextBlock Text="페이지 전체 기본" Style="{StaticResource SideTitle}"/></Border>
                                    <StackPanel Style="{StaticResource SideBody}">
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="글꼴" Style="{StaticResource SideLabel}"/>
                                            <ComboBox x:Name="CmbLFont" IsEditable="True" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="크기 배율" Style="{StaticResource SideLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="TxtLSize" Width="56" VerticalAlignment="Center"
                                                         ToolTip="자동 글자 크기에 곱하는 배율(1 = 그대로)이다냥. px로 정한 풍선은 안 따른다냥"/>
                                                <TextBlock Text="×" Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                <CheckBox x:Name="ChkLBold" Content="굵게" Style="{StaticResource SideCheck}" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="글자 색" Style="{StaticResource SideLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="SwLColor" Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource NekoStroke}" BorderThickness="1"
                                                        Cursor="Hand" VerticalAlignment="Center" Margin="0,0,6,0" MouseLeftButtonUp="Swatch_Click"
                                                        Tag="{Binding ElementName=TxtLColor}" ToolTip="색 고르기"/>
                                                <TextBox x:Name="TxtLColor" Width="92" VerticalAlignment="Center" ToolTip="#RRGGBB — 기본 검정, auto면 원문 색이다냥"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SideRow}">
                                            <TextBlock Text="외곽선" Style="{StaticResource SideLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="TxtLOutScale" Width="56" VerticalAlignment="Center"
                                                         ToolTip="외곽선 두께 배율(1 = 기본, 0 = 없음)이다냥"/>
                                                <TextBlock Text="×" Foreground="{DynamicResource NekoText}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                                <Border x:Name="SwLOutColor" Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource NekoStroke}" BorderThickness="1"
                                                        Cursor="Hand" VerticalAlignment="Center" Margin="0,0,6,0" MouseLeftButtonUp="Swatch_Click"
                                                        Tag="{Binding ElementName=TxtLOutColor}" ToolTip="색 고르기"/>
                                                <TextBox x:Name="TxtLOutColor" Width="92" VerticalAlignment="Center" ToolTip="외곽선 색 #RRGGBB"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 원고 작업대: 격자 작업판 위에 원고(그림자·먹선)를 올려 둔 느낌 -->
        <Border Background="{DynamicResource NekoCanvas}" CornerRadius="0" Margin="16,0,8,0" ClipToBounds="True"
                BorderBrush="{DynamicResource NekoStroke}" BorderThickness="2">
            <Grid>
                <Rectangle Fill="{DynamicResource MangaGrid}" IsHitTestVisible="False"/>
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="Scroller_PreviewMouseWheel" Padding="20">
                    <!-- 원고 그림자 + 먹선 틀. 안쪽 ImageHost는 좌표 기준이라 구조를 안 바꾼다 -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{DynamicResource NekoStroke}" Opacity="0.22" Margin="7,7,-7,-7"/>
                        <Border BorderBrush="{DynamicResource NekoStroke}" BorderThickness="1.5" Background="{DynamicResource NekoBg}">
                            <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  MouseLeftButtonDown="Host_LeftClick" MouseRightButtonDown="Host_RightClick"
                                  MouseDown="Host_MouseDown" MouseUp="Host_MouseUp" MouseLeave="Host_MouseLeave"
                                  MouseMove="Host_MouseMove" Background="Transparent" Cursor="Cross">
                                <Image x:Name="ImgView" Stretch="Fill" SnapsToDevicePixels="True"/>
                                <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
                                <!-- 조각의 성별 표시(2026-11-15): 재생성이 조각마다 어느 성별의 태그로 그리는지 — 눌러서 바꾼다(ResultWindow.Sex.cs).
                                     배경이 없어 자식(표시)만 클릭을 받고, 빈 곳은 아래 ImageHost가 칠하기를 받는다 -->
                                <Canvas x:Name="SexLayer" Visibility="Collapsed"/>
                                <!-- 식자 탭 WYSIWYG: 말풍선 자리에 실제 편집 가능한 텍스트박스를 띄운다 -->
                                <Canvas x:Name="EditLayer" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <!-- 로딩 오버레이 — [지우기]로 이 장을 다시 렌더링하는 동안 캔버스를 덮는다 (2026-11-11 사용자 요청: 별도 창 대신 창 안 오버레이).
                     테마 색은 전부 DynamicResource(app-ui.md 규칙). 취소는 단계 경계에서 멈춘다 — 안내 글은 누른 뒤에만 보인다 -->
                <Grid x:Name="PnlLoading" Visibility="Collapsed" Background="{DynamicResource NekoBg}" Opacity="0.9">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                        <ui:ProgressRing IsIndeterminate="True" Width="56" Height="56" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLoadStage" Text="준비 중" Foreground="{DynamicResource NekoText}" FontSize="15" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,4"/>
                        <TextBlock x:Name="TxtLoadPct" Text="" Foreground="{DynamicResource NekoHint}" TextAlignment="Center"/>
                        <TextBlock x:Name="TxtLoadCancelNote" Text="취소했다냥 — 지금 단계가 끝나면 멈춘다냥 (결과물은 그대로)" Visibility="Collapsed"
                                   Foreground="{DynamicResource NekoHint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <ui:Button x:Name="BtnLoadCancel" Content="취소" Click="BtnLoadCancel_Click" Padding="16,6" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</ui:FluentWindow>
