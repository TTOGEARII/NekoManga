<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NekoManga</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.9.0</Version>
    <StartupObject>NekoManga.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- 업데이트 적용 중 자체 스플래시 창이 쓰는 이미지 (UpdateService.StartApplySplash) -->
    <Content Include="..\..\assets\splash.gif" Link="assets\splash.gif" CopyToOutputDirectory="PreserveNewest" />
    <!-- 내장 검열제거 재생성 워크플로(사용자가 ComfyUI에서 짠 화면 포맷 JSON) — 엔진 탭의 "ComfyUI에 넣기"가 ComfyUI 워크플로 폴더로 복사한다 -->
    <Content Include="..\..\assets\workflows\NekoManga_decensor_regen.json" Link="assets\workflows\NekoManga_decensor_regen.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 자가 학습 스크립트 — ComfyUI의 python_embeded(torch+ultralytics 내장)로 실행 (SelfTrainer) -->
    <Content Include="..\..\assets\training\selftrain.py" Link="assets\training\selftrain.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <!-- vpk CLI(워크플로)와 메이저 버전을 반드시 맞출 것 — 0.0.x 라이브러리 + 1.x 패커 조합은
         Setup.exe가 창도 로그도 없이 행업한다 (v0.1.1에서 실제 발생). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="..\NekoManga.Core\NekoManga.Core.csproj" />
    <!-- DirectML.dll을 실행 파일 옆에 둔다 (2026-11-09). Microsoft.AI.DirectML 패키지는 PlatformTarget이 x64 등으로 지정된 프로젝트에만 DLL을 복사해서
         AnyCPU인 이 솔루션에는 한 번도 들어오지 않았다 → onnxruntime이 Windows에 딸린 옛 DirectML 1.0(System32)을 대신 불러 DML 세션 생성이
         887A0004(DXGI_ERROR_UNSUPPORTED)로 실패하고 **모든 모델이 조용히 CPU로 돌았다**(설치본도 같았다). 버전은 OnnxRuntime.DirectML이 끌어오는 것과 맞출 것. -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" ExcludeAssets="build" />
    <Content Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>

