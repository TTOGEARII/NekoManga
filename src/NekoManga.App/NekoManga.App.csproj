<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NekoManga</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.4.1</Version>
    <StartupObject>NekoManga.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- 업데이트 적용 중 자체 스플래시 창이 쓰는 이미지 (UpdateService.StartApplySplash) -->
    <Content Include="..\..\assets\splash.gif" Link="assets\splash.gif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <!-- vpk CLI(워크플로)와 메이저 버전을 반드시 맞출 것 — 0.0.x 라이브러리 + 1.x 패커 조합은
         Setup.exe가 창도 로그도 없이 행업한다 (v0.1.1에서 실제 발생). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="..\NekoManga.Core\NekoManga.Core.csproj" />
  </ItemGroup>

</Project>
