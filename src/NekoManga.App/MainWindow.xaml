<ui:FluentWindow x:Class="NekoManga.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NekoManga" Height="700" Width="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource NekoBg}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 창 전체에 깔리는 은은한 톤망점 (원고 질감) -->
        <Rectangle Fill="{DynamicResource MangaDots}" Grid.RowSpan="4" IsHitTestVisible="False"/>

        <ui:TitleBar Grid.Row="0" Title="NekoManga">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource NekoLogo}"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <TextBlock x:Name="TxtVersion" VerticalAlignment="Center" Margin="8,0"
                           Foreground="{StaticResource NekoHint}" FontSize="12"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ── 기능 토글 카드 3장 + 실행 버튼 ── -->
        <Grid Grid.Row="1" Margin="16,8,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource NekoFeatureCard}" Margin="0,0,8,0">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="SwColor" DockPanel.Dock="Right" VerticalAlignment="Center"
                                     Checked="Feature_Changed" Unchecked="Feature_Changed"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardTitle}" Text="🎨 자동 채색"/>
                            <Border x:Name="BadgeColor" Background="#33FFB020" CornerRadius="0"
                                    Padding="6,1" Margin="8,0,0,0" Visibility="Collapsed"
                                    ToolTip="이 기능은 ComfyUI가 필요해요 — 설정 → 구성요소에서 설치해 주세요 (약 11GB)">
                                <TextBlock Text="⚠ ComfyUI 설치 필요" FontSize="10.5" Foreground="#FFCF6E"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="흑백 원고를 AI가 풀컬러로"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource NekoFeatureCard}" Margin="0,0,8,0">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="SwDecensor" DockPanel.Dock="Right" VerticalAlignment="Center"
                                     Checked="Feature_Changed" Unchecked="Feature_Changed"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardTitle}" Text="🙈 검열 제거"/>
                            <Border x:Name="BadgeDecensor" Background="#33FFB020" CornerRadius="0"
                                    Padding="6,1" Margin="8,0,0,0" Visibility="Collapsed"
                                    ToolTip="강력 모드는 ComfyUI가 필요해요 — 기본 모드는 바로 쓸 수 있어요">
                                <TextBlock Text="⚠ 강력 모드: ComfyUI 필요" FontSize="10.5" Foreground="#FFCF6E"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="HintDecensor" Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="모자이크를 찾아 자연스럽게 복원"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource NekoFeatureCard}" Margin="0,0,8,0">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="SwTranslate" DockPanel.Dock="Right" VerticalAlignment="Center"
                                     Checked="Feature_Changed" Unchecked="Feature_Changed"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="💬 번역"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="말풍선을 읽고 한국어로 식자까지 · 내장 AI"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <ui:Button x:Name="BtnRun" Click="BtnRun_Click" Appearance="Primary"
                           FontWeight="Bold" FontSize="15" Padding="22,12"
                           Content="✦ 시작! (ﾉ´ヮ`)ﾉ*:･ﾟ✧"/>
                <ui:Button x:Name="BtnStop" Click="BtnStop_Click" IsEnabled="False"
                           Margin="0,6,0,0" Padding="22,6" HorizontalAlignment="Stretch"
                           Content="멈추기"/>
            </StackPanel>
        </Grid>

        <!-- ── 파일 목록 / 드롭존 ── -->
        <Grid Grid.Row="2" Margin="16,8">
            <Border x:Name="DropHint" Background="{DynamicResource NekoCard}"
                    BorderBrush="{StaticResource NekoStroke}" BorderThickness="2"
                    CornerRadius="0" Visibility="Visible">
                <Grid>
                    <!-- 만화 원고 격자 + 톤망점 질감 (은은하게 겹침) -->
                    <Rectangle Fill="{DynamicResource MangaDots}"/>
                    <Rectangle Fill="{DynamicResource MangaGrid}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="{StaticResource NekoLogo}" Width="96" Height="96" HorizontalAlignment="Center"/>
                        <TextBlock Text="만화 이미지나 폴더를 여기에 끌어다 놓으세요" FontSize="16"
                                   Margin="0,16,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource NekoText}"/>
                        <TextBlock Text="png · jpg · webp 지원" Style="{StaticResource HintText}"
                                   Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        <ui:Button Content="파일 고르기" Click="BtnPick_Click" Margin="0,16,0,0"
                                   HorizontalAlignment="Center" Padding="18,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 목록(썸네일 포함) + 고른 장의 큰 미리보기 -->
            <Grid x:Name="ListPane" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="380" MinWidth="220"/>
                </Grid.ColumnDefinitions>

                <ListView x:Name="FileList" Grid.Column="0" Background="Transparent"
                          BorderThickness="0" SelectionMode="Extended"
                          SelectionChanged="FileList_SelectionChanged"
                          MouseDoubleClick="FileList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="64">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource NekoCanvas}" CornerRadius="0" Width="52" Height="68">
                                            <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="파일" Width="190" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="상태" Width="190" DisplayMemberBinding="{Binding Stage}"/>
                            <GridViewColumn Header="진행" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100"
                                                     Height="8" Width="84" Foreground="{StaticResource NekoPink}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="Transparent"/>

                <!-- 원고 작업대: 격자 캔버스 위에 재단선(트림마크)으로 원고를 올려 둔 느낌 -->
                <Border Grid.Column="2" Background="{DynamicResource NekoCanvas}" CornerRadius="0"
                        BorderBrush="{StaticResource NekoStroke}" BorderThickness="2" Padding="0">
                    <DockPanel>
                        <!-- 상단 라벨 바 (원고 핀업 태그) -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource NekoStroke}" Padding="8,4">
                            <TextBlock x:Name="TxtPreviewName" Foreground="{DynamicResource NekoBg}"
                                       FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Text="미리보기"/>
                        </Border>
                        <ui:Button x:Name="BtnEditThis" DockPanel.Dock="Bottom" Content="✏ 이 장 수정하기"
                                   Click="BtnViewResult_Click" Margin="8" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" Padding="10,6"/>
                        <!-- 격자 작업판 + 원고(그림자·테두리) + 네 귀 트림마크 -->
                        <Grid Margin="10">
                            <Rectangle Fill="{DynamicResource MangaGrid}"/>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14">
                                <!-- 원고 그림자 -->
                                <Border Background="{DynamicResource NekoStroke}" Opacity="0.25" Margin="6,6,-6,-6"/>
                                <Border Background="{DynamicResource NekoBg}" BorderBrush="{DynamicResource NekoStroke}" BorderThickness="1.5">
                                    <Image x:Name="ImgPreview" Stretch="Uniform" SnapsToDevicePixels="True" Margin="1"/>
                                </Border>
                                <!-- 트림마크: 네 귀 ㄱ자 재단선 -->
                                <Path Stroke="{DynamicResource NekoStroke}" StrokeThickness="2"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,-10,0,0"
                                      Data="M0,12 L0,0 L12,0"/>
                                <Path Stroke="{DynamicResource NekoStroke}" StrokeThickness="2"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0"
                                      Data="M12,12 L12,0 L0,0"/>
                                <Path Stroke="{DynamicResource NekoStroke}" StrokeThickness="2"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-10,0,0,-10"
                                      Data="M0,0 L0,12 L12,12"/>
                                <Path Stroke="{DynamicResource NekoStroke}" StrokeThickness="2"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-10"
                                      Data="M12,0 L12,12 L0,12"/>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ── 하단 바 ── -->
        <Border Grid.Row="3" Padding="16,10" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource NekoStroke}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Content="⚙ 설정" Click="BtnSettings_Click" Padding="14,6"/>
                    <ui:Button Content="📂 결과 폴더" Click="BtnOpenOutput_Click" Padding="14,6" Margin="8,0,0,0"/>
                    <ui:Button x:Name="BtnViewResult" Content="🔍 결과 보기·수정" Click="BtnViewResult_Click"
                               Padding="14,6" Margin="8,0,0,0"/>
                    <ui:Button x:Name="BtnClear" Content="목록 비우기" Click="BtnClear_Click" Padding="14,6" Margin="8,0,0,0"/>
                    <ui:Button x:Name="BtnUpdate" Content="🎀 새 버전!" Click="BtnUpdate_Click"
                               Appearance="Caution" Padding="14,6" Margin="8,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource NekoHint}" Text="준비 완료 ♪"/>
                <Border/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
