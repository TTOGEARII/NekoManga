<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Core가 GDI+(System.Drawing)·OpenCV 윈도우 런타임을 쓰므로 테스트도 Windows 전용이다 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NekoManga.Core\NekoManga.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 앱에 내장된 검열 제거 재생성 워크플로(ComfyUI 화면 저장 포맷) — 포맷 변환 테스트의 실제 입력으로 쓴다 -->
    <Content Include="..\..\assets\workflows\NekoManga_decensor_regen.json" Link="TestData\NekoManga_decensor_regen.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
